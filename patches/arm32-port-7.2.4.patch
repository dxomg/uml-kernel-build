diff --git a/arch/arm/Makefile.um b/arch/arm/Makefile.um
new file mode 100644
index 000000000..046f35987
--- /dev/null
+++ b/arch/arm/Makefile.um
@@ -0,0 +1,133 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Build glue for ARCH=um SUBARCH=arm.
+#
+# Included by arch/um/Makefile as $(HOST_DIR)/Makefile.um. Everything here
+# describes the *host* ABI the UML binary is built against, because for UML the
+# "architecture" is an ordinary armv7 (EABI) userspace process.
+
+# Link address of the UML kernel binary. Guest processes live in separate host
+# address spaces under SKAS, so this only has to stay clear of the UML kernel's
+# own mappings of guest physical memory, which are placed above the binary.
+# 0x8048000 is the classic 32-bit non-PIE text base that the i386 UML port has
+# used for decades, and it is what arm32 toolchains link non-PIE executables
+# to by default as well.
+START := 0x8048000
+
+ELF_ARCH	:= arm
+ELF_FORMAT	:= elf32-littlearm
+
+CHECKFLAGS	+= -D__arm__
+
+# The parent architecture's headers must believe they are looking at ARMv7,
+# or their barriers and atomic operations degrade to nothing: arch/arm's
+# barrier.h only emits a real "dsb" when the code is compiled for v6 or later,
+# and its cmpxchg64 / queued-spinlock helpers switch on the same. Without
+# this a UML host silently gets a UP stub barrier and a word-at-a-time
+# cmpxchg, and every multi-CPU guest build breaks. There is no per-CPU_32v*
+# kernel config to ask for it -- the parent Kconfig is not sourced for ARCH=um
+# -- so the architecture level has to come from the preprocessor.
+KBUILD_CPPFLAGS += -D__LINUX_ARM_ARCH__=7
+
+# Keep the FPU out of the whole UML binary, for two independent reasons:
+#
+# The guest's VFP/NEON state belongs to the guest. UGL preserves it through
+# PTRACE_GETVFPREGS/SETVFPREGS (boot probe) and the VFP block in host
+# sigframes, and the stub never runs host code that would touch V registers.
+# If any object in the binary used V registers, the state saved for the guest
+# would be whatever the host compiler last left there -- and the guest's float
+# arithmetic would be wrong in ways that only surface on a slow CPU.
+#
+# -mfloat-abi=soft is not just "don't use the FPU in arithmetic". The host
+# compiler's code motion and inlining may still emit VFP instructions for
+# struct copies or function prologues, so the flag has to hold for the kernel
+# and the USER objects alike. It does no harm to them: guest user-space is
+# not our binary; it is exec'd from guest memory and its VFP use is exactly
+# what UGL is preserving.
+#
+# -march=armv7-a pins the host baseline explicitly. The guest is armv7 (the
+# subarch's 32-bit EABI), and the host must not be able to drift below it --
+# a build on an old armv5 host would emit code the stub cannot run, and no
+# error anywhere in the build would say so. The -a is mandatory, not style:
+# gcc refuses a bare "-march=armv7 -marm" with "target CPU does not support
+# ARM mode" (the generic armv7 target carries no ARM state), and the distro
+# cross gcc -- Ubuntu's armel toolchain is built --with-mode=thumb -- takes
+# Thumb as its default state anyway, so the state has to be pinned here.
+#
+# -marm pins ARM (32-bit) state: the two states encode the same source
+# differently -- "svc #0" is 0xea000000 in ARM state and 0xdf00 in Thumb.
+# UGL compares the host instruction word it is about to step over against
+# UM_SYSCALL_TRAP_INSN, a 32-bit value (arch/arm/um/shared/sysdep/ptrace_user.h),
+# so the stub's code must be ARM state without exception. Interworking stays
+# on, so glibc or bionic objects with mixed code link fine.
+
+KBUILD_CFLAGS += -mfloat-abi=soft -march=armv7-a -marm
+
+# The .S files are assembled through the host's gcc, and gas takes its
+# ARM/Thumb state from the driver's default, which UGL cannot rely on:
+# setjmp_arm.S is written for the ARM state ("svc #0" is 0xea000000, the
+# stub's resume path is compared against that word in
+# arch/arm/um/shared/sysdep/ptrace_user.h), so pin the state here as well.
+KBUILD_AFLAGS += -march=armv7-a -marm
+
+# The vmlinux link runs through $(CC), which appends its implicit -lgcc after
+# every explicit input. Once anything in the link leaves a member of libgcc's
+# division family to satisfy, ld pulls that member in -- and its __udivsi3 /
+# __aeabi_uidiv / __divsi3 / __aeabi_idiv then collide with the very same
+# symbols arm-klib.o defines out of the kernel's own arch/arm/lib/lib1funcs.S.
+# Those copies cannot be dropped: modpost reads vmlinux.o, which has no
+# libgcc, and the module loader patches guest .ko relocations against
+# vmlinux's symbol table, so the kernel's own helpers have to be what
+# vmlinux defines. --allow-multiple-definition makes the pulled members
+# no-ops: the first definition wins, and vmlinux.a (whole-archived ahead of
+# -lgcc) is first, so every reference keeps binding to the kernel's copy
+# exactly as it did before the pull. Scoped to KBUILD_LDFLAGS, which
+# arch/um/Makefile folds into CFLAGS_vmlinux with a -Wl, prefix per flag;
+# relocatable links ignore it.
+KBUILD_LDFLAGS += --allow-multiple-definition
+
+LINK-$(CONFIG_LD_SCRIPT_DYN_RPATH) += -Wl,-rpath,/lib
+
+# Building against bionic (the Android NDK) collides with the kernel's own
+# definitions of a set of standard-library names. glibc does not show this:
+# its libc.a is finely split, so the objects carrying memcpy, snprintf and the
+# rest are simply never pulled in once the kernel's definitions satisfy every
+# reference. bionic's libc.a is coarser -- the objects that *are* needed also
+# define these -- and the static link then fails with twenty duplicate symbols.
+#
+# Resolving it with --allow-multiple-definition is worse than not building:
+# link order puts the kernel first, so libc's internals end up calling the
+# kernel's memcpy and sem_init, and the binary segfaults before main().
+#
+# The string family is handled in arch/arm/um/asm/string.h instead, by
+# declaring __HAVE_ARCH_* so lib/string.c does not compile its own -- renaming
+# those fights CONFIG_FORTIFY_SOURCE, which redefines them as macros.
+#
+# The rest are renamed, which is exactly what UML already does for
+# errno, sigprocmask, mktime and strrchr in arch/um/Makefile. These defines
+# reach kernel objects only, never USER_OBJS, so host-side code and libc keep
+# the real names. Compiler-emitted implicit calls (struct copies lowering to
+# memcpy) also keep the real name and get libc's implementation, which is
+# correct and usually faster than the kernel's generic C.
+#
+# The list is not guesswork and not the duplicate-symbol errors either. Those
+# only catch names both sides *define*; the dangerous case is a name libc
+# merely *references* while the kernel defines it, because then there is no
+# error at all -- the reference simply binds to the kernel's function.
+#
+# So the list is the intersection of "undefined in bionic's libc.a" with
+# "defined in vmlinux.a", computed with llvm-nm:
+#
+#   llvm-nm --undefined-only libc.a         | sort -u > A
+#   llvm-nm --defined-only --extern-only vmlinux.a | sort -u > B
+#   comm -12 A B
+#
+# Detected from the compiler rather than configured, because the whole
+# difference is which libc the target triple selects.
+UM_BIONIC := $(shell echo | $(CC) $(CLANG_FLAGS) -dM -E - 2>/dev/null | grep -c __ANDROID__)
+
+ifeq ($(UM_BIONIC),1)
+# Renamed on the object files at link time, not here: see
+# arch/arm/um/bionic-syms.redef for the list and for why -D is the wrong tool.
+export UM_REDEF_SYMS := $(srctree)/arch/arm/um/bionic-syms.redef
+endif
diff --git a/arch/arm/lib/bitops.h b/arch/arm/lib/bitops.h
index f069d1b23..a74cb1199
--- a/arch/arm/lib/bitops.h
+++ b/arch/arm/lib/bitops.h
@@ -1,6 +1,17 @@
 /* SPDX-License-Identifier: GPL-2.0 */
 #include <asm/assembler.h>
 #include <asm/unwind.h>
+
+/*
+ * The macro definitions below are meant to reach the assembler once per
+ * assembly input. The parent arm build is built that way: every
+ * arch/arm/lib .S file is assembled as its own object, so each preprocessor
+ * sees this file exactly once. UML's arm32 port links several of those files
+ * into a single object (arch/arm/um/arm-klib.S), so guard the block or the
+ * .macro definitions would reach gas once per included file.
+ */
+#ifndef ARCH_ARM_LIB_BITOPS_H
+#define ARCH_ARM_LIB_BITOPS_H
 
 #if __LINUX_ARM_ARCH__ >= 6
 	.macro	bitop, name, instr
@@ -113,3 +124,5 @@
 ENDPROC(\name		)
 	.endm
 #endif
+
+#endif /* ARCH_ARM_LIB_BITOPS_H */
diff --git a/arch/arm/um/Kconfig b/arch/arm/um/Kconfig
new file mode 100644
index 000000000..f67e096c0
--- /dev/null
+++ b/arch/arm/um/Kconfig
@@ -0,0 +1,169 @@
+# SPDX-License-Identifier: GPL-2.0
+
+config UML_ARM
+	def_bool y
+	select ARCH_SUPPORTS_ATOMIC_RMW
+	#
+	# SMP. The subarch pieces it needs are already correct rather than
+	# merely untested: setjmp_arm.S saves the AAPCS callee-saved set
+	# (r4-r11) plus sp and lr and nothing thread-local, so a switch_buf
+	# built on one CPU thread is safe to longjmp from another. The one
+	# register a host compiler may use for per-thread TLS, R8, is the
+	# guest's and is carried like every other general register -- it is
+	# part of the GP regset PTRACE_GETREGS returns, and
+	# os-Linux/registers.c synchronizes it on every switch. VFP state
+	# never lives in the stub's registers at all: the UGL binary is
+	# built without any FP, so a shared stub cannot lose a guest's.
+	#
+	# NR_CPUS is only a ceiling: the count that is actually brought up is
+	# the ncpus= boot argument, clamped to it. So one binary serves any
+	# host, and a host that cannot do SMP at all (ptrace userspace) boots
+	# on one CPU rather than refusing to boot.
+	select UML_SUBARCH_SUPPORTS_SMP
+	#
+	# Spinlocks and rwlocks stay the parent's ticket locks; the ARCH_USE_
+	# QUEUED_* selects the x86 and arm64 subarchs take are not available
+	# here. The generic queued implementation redefines arch_spinlock_t
+	# as struct qspinlock, while arch/arm's ticket locks type it as a
+	# different struct, so a translation unit that includes both
+	# <asm/spinlock.h> and <asm/qspinlock.h> is a typedef conflict rather
+	# than a choice, and arch/arm ships no <asm/qspinlock.h> to bridge
+	# them. A UML guest's locks serialize threads of one host process on
+	# the host's atomics, where the ticket locks the parent ships for
+	# SMP are exactly good enough.
+	#
+	# The guest is ARMv7, which has the efficient unaligned access
+	# hardware. The parent gates this on CPU_V6 and later plus MMU;
+	# UGL is unconditionally v7 with MMU, so the capability is on.
+	select HAVE_EFFICIENT_UNALIGNED_ACCESS
+	#
+	# Loadable modules. arm modules are ELF REL (the parent arch/arm
+	# selects MODULES_USE_ELF_REL for exactly this reason), and the
+	# relocation processing is arch/arm/kernel/module.c reused verbatim
+	# -- the same arrangement x86 UML has used for its own module.c for
+	# years (subarch-$(CONFIG_MODULES) in the Makefile). There is no
+	# arm equivalent of arm64's module-plts.c or insn.o: arm relocations
+	# patch fixed 32-bit immediates, which module.c computes in C.
+	#
+	select MODULES_USE_ELF_REL
+	#
+	# Goes with it: arch/arm's struct mod_arch_specific carries the
+	# per-module bookkeeping, so the generic module loader expects it.
+	select HAVE_MOD_ARCH_SPECIFIC
+	#
+	# The guest's off_t is 32 bits, like every real arm32 kernel. That
+	# flips force_o_largefile() in include/linux/fcntl.h: on a 32-bit
+	# off_t architecture sys_open() must *not* force O_LARGEFILE -- the
+	# guest's 32-bit syscalls are the ABI, and O_LARGEFILE is the guest
+	# application's flag, not the kernel's.
+	select ARCH_32BIT_OFF_T
+	#
+	# The 32-bit arm syscall ABI. The EABI table this subarch links
+	# against (arch/arm/um/asm/syscall_table_eabi.h) and the generic
+	# ipc/syscall.c and kernel/signal.c dispatches it compiles are the
+	# parent arch/arm's, and the parent wires them up with three
+	# selects its `config ARM` makes unconditionally
+	# (arch/arm/Kconfig L53/L151/L152) -- a Kconfig that an ARCH=um build
+	# never parses. Without them the versioned IPC dispatch still
+	# compiles (arch/arm's unistd.h defines __ARCH_WANT_SYS_IPC and UGL
+	# picks it up as-is), but the ksys_old_* wrappers it calls live
+	# behind CONFIG_ARCH_WANT_IPC_PARSE_VERSION, and the EABI
+	# sigaction(2)/sigsuspend(2) the table maps __NR_sigaction /
+	# __NR_sigsuspend to live behind CONFIG_OLD_SIGACTION and
+	# CONFIG_OLD_SIGSUSPEND3, so every one of them is an undefined
+	# reference at the first UGL link.
+	select ARCH_WANT_IPC_PARSE_VERSION
+	select OLD_SIGACTION
+	select OLD_SIGSUSPEND3
+	#
+	# Frame pointers, as arch/arm64/Kconfig selects them for real
+	# hardware.
+	#
+	# Not a debug preference. UML's stack walker chains through the
+	# frame pointer and falls back to scanning the stack for anything
+	# that looks like a text address; get_frame_pointer() returns 0
+	# outright when CONFIG_FRAME_POINTER is off (arch/um/include/asm/stacktrace.h),
+	# so the chain never advances, every frame is a guess, and
+	# save_stack_trace() -- which keeps only frames marked reliable --
+	# returns nothing at all.
+	#
+	# Without this the behaviour depends on CONFIG_DEBUG_INFO, because
+	# FRAME_POINTER is "default y if (DEBUG_INFO && UML)" and UML selects
+	# nothing. So backtraces work in a development build and silently stop
+	# working in the size-tuned build someone puts on a phone, which is
+	# precisely where a backtrace is the only debugging tool left.
+	select ARCH_WANT_FRAME_POINTERS
+
+config 32BIT
+	def_bool y
+
+# Defined, not selected: these are per-architecture symbols with no central
+# definition, exactly as arch/x86/um/Kconfig defines GENERIC_HWEIGHT.
+config GENERIC_HWEIGHT
+	def_bool y
+
+# arch/arm/lib's checksum routines are kernel-only assembly written against
+# the EL1 uaccess model. The generic C implementations in lib/checksum.c are
+# correct and are not on any hot path for a guest whose network device is a
+# host socket.
+config GENERIC_CSUM
+	def_bool y
+
+#
+# The parent arch/arm/Kconfig is not sourced for ARCH=um, so the two memory-
+# layout values its headers compute from are supplied here. The parent puts
+# PAGE_OFFSET in the "Processor type and features" menu and PHYS_OFFSET in
+# "Processor support"; neither menu exists in a UML build.
+#
+# PAGE_OFFSET: TASK_SIZE -- and therefore the whole user-space map -- is
+# PAGE_OFFSET - SZ_16M in arch/arm/include/asm/memory.h. The classic 1G split
+# is the honest answer for a 32-bit guest: user space gets everything below
+# 0xC0000000, and the module space between TASK_SIZE and PAGE_OFFSET that
+# the parent's module.h lays out stays where the parent's relocator expects
+# it.
+config PAGE_OFFSET
+	hex
+	default 0xC0000000
+
+# PHYS_OFFSET: the guest's physical addresses are its own virtual addresses,
+# so the offset is zero and virt_to_phys()/phys_to_virt() are identity math
+# on top of it.
+config PHYS_OFFSET
+	hex
+	default 0x0
+
+# FUNCTION_ALIGNMENT: linkage.h's __ALIGN expands to
+# ".balign CONFIG_FUNCTION_ALIGNMENT", and the arch/arm .S objects
+# pulled into the host binary through arm-klib.S materialize it in gas
+# input. The symbol's definition lives in arch/Kconfig, which is not
+# sourced for ARCH=um, so without a value the literal reaches gas
+# unexpanded and as fails with
+# "bad or irreducible absolute expression". The arch/Kconfig default
+# chain bottoms out at 0 unless a FUNCTION_ALIGNMENT_NB select fires,
+# and the one mainline selector (DEBUG_FORCE_FUNCTION_ALIGN_64B) is
+# gated on EXPERT plus a non-arm arch; a plain arm kernel's defconfig
+# resolves to 0 as well.
+config FUNCTION_ALIGNMENT
+	int
+	default 0
+
+# Deliberately *not* "config ARM". Generic code tests CONFIG_ARM to mean
+# "running on real arm hardware in the kernel" -- it gates things like the
+# arm32 hardware description, cpuidle and cp15 maintenance code, none of
+# which exist for a UML guest, which is an ordinary userspace process. The
+# subarch advertises itself as UML_ARM instead, exactly as x86 UML would
+# if it were written today, and selects the individual capabilities it
+# really has.
+#
+# Also deliberately *not* selected:
+#
+# CLONE_BACKWARDS -- that is the aarch64 psABI, where clone() takes
+# (flags, stack, pid, *tls, tid). arm32's EABI keeps the generic order
+# (flags, stack, pid, tid, *tls), and the guest's glibc was built against
+# exactly that. Selecting it would swap two arguments the guest never
+# asked to be swapped.
+#
+# HAVE_PAGE_SIZE_16KB -- a 16 KB arm32 host is not a real target. The 16
+# KB-page requirement the arm64 port exists for (Android 15+) is an
+# arm64-only Android configuration, and a 4 KB UML guest cannot boot on a
+# 16 KB host anyway, so offering the symbol would be untestable decoration.
diff --git a/arch/arm/um/Makefile b/arch/arm/um/Makefile
new file mode 100644
index 000000000..cd814cfd6
--- /dev/null
+++ b/arch/arm/um/Makefile
@@ -0,0 +1,89 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# arch/arm/um -- subarch support for ARCH=um SUBARCH=arm
+#
+
+obj-y = bugs.o cpuinfo.o delay.o fault.o mem.o ptrace.o \
+	setjmp_arm.o signal.o stub_segv.o syscalls.o \
+	sys_call_table.o sysrq.o tls.o \
+	subarch.o os-Linux/
+
+# Link the arch/arm/lib objects that generic code binds to through the parent's
+# <asm/bitops.h> and <asm/div64.h> into the host binary, plus the div helpers
+# the armv7-a host compiler emits, and publish them the way
+# arch/arm/kernel/armksyms.c does. Why these are missing otherwise and what
+# each file is for: see arm-klib.S.
+obj-y += arm-klib.o arm_ksyms.o
+
+# Module loading is the parent architecture's, reused rather than reimplemented.
+# arm relocations patch fixed 32-bit immediates -- R_ARM_PC24, R_ARM_ABS32 and
+# friends -- and arch/arm/kernel/module.c computes every one of them in C, so
+# there is nothing to build alongside it: no equivalent of arm64's module-plts.o
+# or insn.o. x86 UML has taken exactly this approach to its own module.c for
+# years -- see arch/x86/um/Makefile.
+subarch-$(CONFIG_MODULES) += ../kernel/module.o
+
+# Built with USER_CFLAGS against host headers rather than kernel headers:
+# these speak to the host kernel, not to the guest.
+USER_OBJS := bugs.o fault.o
+
+# USER_CFLAGS is derived from KBUILD_CFLAGS, so it loses every -I that
+# KBUILD_CPPFLAGS adds -- including the parent architecture's include dirs,
+# which is where <asm/*.h> resolves in this build. These objects still pull
+# kernel headers: bugs.c reaches <linux/bug.h> -> <asm/bug.h> and
+# linux/compiler.h -> <asm/rwonce.h>, and linux/linkage.h -> <asm/linkage.h>;
+# os-Linux/registers.c reaches <linux/elf.h> -> <asm/elf.h>. Without a
+# parent-asm search path gcc dies on the first of those ("asm/rwonce.h: No
+# such file or directory" in bugs.o). Append the parent's real and generated
+# include dirs as -idirafter, so they are searched behind everything
+# USER_CFLAGS already carries and only fill the gaps: <asm/bug.h> keeps
+# resolving to the um generic wrapper (arm's own would wire BUG() to the
+# parent's UDEF trap, which no UML host handles), and headers this build
+# shadows in arch/arm/um/asm/ for kernel objects are unaffected here.
+# Exported (arch/um/Makefile exports USER_CFLAGS), so the append also reaches
+# the nested os-Linux/ sub-make and its registers.o/mcontext.o.
+USER_CFLAGS += -idirafter $(srctree)/arch/arm/include \
+	       -idirafter $(objtree)/arch/arm/include/generated
+
+$(obj)/user-offsets.s: c_flags = -Wp,-MD,$(depfile) $(USER_CFLAGS) \
+	-Iarch/arm/include/generated
+targets += user-offsets.s
+
+# Re-apply the one assembler force-include that the parent architecture's own
+# build always applies, from the top of arch/arm/Makefile:
+#
+# 	KBUILD_AFLAGS += ... -include $(srctree)/arch/arm/include/asm/unified.h
+#
+# That file is not parsed for ARCH=um, and without it nothing in this
+# directory's .S context knows that the arch/arm/lib sources are being
+# assembled in a unified-syntax, ARM-state setting:
+#
+# - unified.h defines the W() / ARM() / THUMB() macros that asm/assembler.h
+#   and the arch/arm/lib .S files all use (W(pldw), ARM(fpreg .req r11),
+#   THUMB(orr ...), ...) and emits `.syntax unified` in assembly contexts.
+#   Unified syntax is what lets gas accept the ARM-state mnemonics those
+#   files contain whatever the toolchain's default instruction set state
+#   is: the armel cross gcc and gas are built with Thumb as the default
+#   state, so the syntax has to be forced rather than assumed.
+#
+# - -march=armv7-a gives gas the v7 instruction set the sources expect
+#   (pldw, dmb, .arch_extension mp) and -marm states what the .S sources
+#   state on their own (.arm directives in setjmp_arm.S and arm-klib.S).
+#
+# asflags-y rather than KBUILD_AFLAGS: it has to hold in the directory
+# sub-make that assembles this directory's objects, and that is the level
+# Kbuild guarantees (scripts/Makefile.build folds subdir-asflags-y into
+# a_flags there); the top-level KBUILD_AFLAGS reaches that sub-make only
+# as an exported environment value.
+asflags-y += -include $(srctree)/arch/arm/include/asm/unified.h
+asflags-y += -march=armv7-a -marm
+
+include/generated/user_constants.h: $(obj)/user-offsets.s FORCE
+	$(call filechk,offsets,__USER_CONSTANT_H__)
+
+# The SIGSEGV stub handler runs on the guest's stack inside the stub process
+# with no libc and no stack protector available.
+UNPROFILE_OBJS := stub_segv.o
+CFLAGS_stub_segv.o := $(CFLAGS_NO_HARDENING)
+
+include $(srctree)/arch/um/scripts/Makefile.rules
diff --git a/arch/arm/um/arm-klib.S b/arch/arm/um/arm-klib.S
new file mode 100644
index 000000000..f512a7b99
--- /dev/null
+++ b/arch/arm/um/arm-klib.S
@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * arch/arm/lib objects, pulled into the UML host binary.
+ *
+ * arch/arm/lib is a device-kernel directory: it is only ever built for
+ * ARCH=arm, so none of its definitions exist in an ARCH=um build. Yet the
+ * parent's headers that UGL deliberately reuses (arch/arm/include/asm is on
+ * the include path for the host objects) declare a number of these as
+ * extern, and generic kernel code binds to them:
+ *
+ *   arch/arm/include/asm/bitops.h   -> _clear_bit, _set_bit,
+ *                                      _test_and_set_bit, _test_and_clear_bit,
+ *                                      _change_bit, _test_and_change_bit and
+ *                                      the _find_next_bit_le family
+ *   arch/arm/include/asm/div64.h    -> __do_div64 (every do_div on 32-bit)
+ *
+ * and the armv7-a host compiler, with hardware division off (the +div
+ * target feature is not part of the armv7-a baseline, and UGL pins the
+ * baseline so the binary keeps running on hosts without it), lowers 32-bit
+ * signed division to calls to __aeabi_idiv / __aeabi_uidiv.
+ *
+ * A plain build is fine with all of these: vmlinux is linked against the
+ * host libc, which supplies the div and shift helpers, and the bitops
+ * families are only referenced by module objects. modpost, however, sees
+ * only what vmlinux itself defines, so the moment CONFIG_MODULES turns on
+ * it fails the build with
+ *
+ *   ERROR: modpost: "_clear_bit" [fs/binfmt_misc.ko] undefined!
+ *   ERROR: modpost: "__do_div64" [block/bfq.ko] undefined!
+ *   ERROR: modpost: "__aeabi_idiv" [block/bfq.ko] undefined!
+ *
+ * and at run time UGL's module loader (arch/arm/kernel/module.o, reused
+ * verbatim -- see arch/arm/um/Makefile) patches guest .ko relocations
+ * against the host binary, so a guest module's reference to any of these
+ * would dangle as well. The real kernel's answer is simply that arch/arm/lib
+ * is in vmlinux; here the objects are linked in through this include chain
+ * instead, and arch/arm/um/arm_ksyms.c publishes them the way
+ * arch/arm/kernel/armksyms.c does for a real kernel.
+ *
+ * Including the .S files rather than copying them keeps one source of
+ * truth: the routines are the kernel's own, bit for bit.
+ */
+
+/*
+ * Every include below reaches <linux/compiler_attributes.h> (via
+ * <linux/linkage.h> -> <linux/compiler_types.h>; __KERNEL__ is defined
+ * for .S objects, as it is for C): its eighteen #if __has_attribute()
+ * probes are undefined to the assembler-with-cpp preprocessor and each
+ * one would abort the object with "missing binary operator before token
+ * (". Nothing in this target consumes the attribute macros, so report
+ * "no attributes supported" and let every probe take its fallback.
+ */
+#ifndef __has_attribute
+#define __has_attribute(x)	0
+#endif
+
+/*
+ * The included files are written for the ARM instruction set, but the
+ * assembler's default state is a toolchain property -- the armel cross
+ * gas starts in Thumb state -- so pin it, or the plain ARM mnemonics
+ * (strbne, movs, ldrex, ...) would not assemble at all.
+ */
+	.arm
+
+#include "../lib/clearbit.S"
+#include "../lib/setbit.S"
+#include "../lib/testsetbit.S"
+#include "../lib/testclearbit.S"
+#include "../lib/changebit.S"
+#include "../lib/testchangebit.S"
+#include "../lib/findbit.S"
+#include "../lib/div64.S"
+#include "../lib/lib1funcs.S"
+#include "../lib/ashldi3.S"
+#include "../lib/ashrdi3.S"
+#include "../lib/lshrdi3.S"
+#include "../lib/muldi3.S"
+#include "../lib/ucmpdi2.S"
+#include "../lib/bswapsdi2.S"
diff --git a/arch/arm/um/arm_ksyms.c b/arch/arm/um/arm_ksyms.c
new file mode 100644
index 000000000..248d124a4
--- /dev/null
+++ b/arch/arm/um/arm_ksyms.c
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Publish the arch/arm/lib symbols that UGL links into the host binary via
+ * arch/arm/um/arm-klib.S, the way arch/arm/kernel/armksyms.c does for a
+ * real kernel.
+ *
+ * The set is exactly what arm-klib.S defines for this build (little-endian,
+ * no CONFIG_AEABI, ARMv7 host): the single-underscore bitops and the
+ * _le find-bit family the parent's asm/bitops.h binds generic code to,
+ * __do_div64 the parent's asm/div64.h binds every do_div to, and the
+ * div/mod/shift/multiply helpers the armv7-a host compiler lowers 32-bit
+ * signed division into. A guest .ko's relocations are patched against the
+ * host binary by arch/arm/kernel/module.o (see arch/arm/um/Makefile), and
+ * modpost resolves a module's undefined references against this table, so
+ * without it every module that touches a bitops helper or a division fails
+ * the build the moment CONFIG_MODULES is on.
+ */
+#include <linux/bug.h>
+#include <linux/export.h>
+#include <linux/linkage.h>
+
+/*
+ * The divide-by-zero handler the arch/arm/lib helpers (the __aeabi_idiv /
+ * __do_div64 families arm-klib.S links in) branch to on a zero divisor. The
+ * parent defines it in arch/arm/kernel/traps.c, where it turns the division
+ * into a divide-error exception, oops if not recovered; a UGL arm build does
+ * not build arch/arm/kernel (that traps.c is the host-side mechanism, and
+ * UGL has its own), so the guest kernel has to provide the symbol. It is
+ * defined here rather than in the klib-support USER_OBJ bugs.c because it
+ * runs in guest-kernel context and BUG() needs a kernel-side include
+ * environment -- see the note at the end of arch/arm/um/bugs.c.
+ */
+asmlinkage void __div0(void)
+{
+	BUG();
+}
+
+/*
+ * EXPORT_SYMBOL takes the address of the symbol, so every export below
+ * needs a declaration. The parent keeps its families in three places:
+ * the native- and little-endian bitops prototypes in the parent's
+ * asm/bitops.h, the gcc and EABI helpers as one-line void prototypes
+ * in arch/arm/kernel/armksyms.c ("prototypes are not correct though,
+ * but that doesn't really matter since they're not versioned"), and
+ * no prototypes at all for the _sync_ bitops, which the parent's SMP
+ * atomic bitops macros reference by name and only the assembler ever
+ * sees. Declare the whole set here: it is what arm-klib.S defines,
+ * and the UGL include path may shadow or omit the parent's header
+ * with the first two families.
+ */
+extern void _set_bit(int nr, volatile unsigned long * p);
+extern void _clear_bit(int nr, volatile unsigned long * p);
+extern void _change_bit(int nr, volatile unsigned long * p);
+extern int _test_and_set_bit(int nr, volatile unsigned long * p);
+extern int _test_and_clear_bit(int nr, volatile unsigned long * p);
+extern int _test_and_change_bit(int nr, volatile unsigned long * p);
+extern int _sync_test_and_set_bit(int nr, volatile unsigned long * p);
+extern int _sync_test_and_clear_bit(int nr, volatile unsigned long * p);
+extern int _sync_test_and_change_bit(int nr, volatile unsigned long * p);
+
+unsigned long _find_first_zero_bit_le(const unsigned long *p, unsigned long size);
+unsigned long _find_next_zero_bit_le(const unsigned long *p,
+				     unsigned long size, unsigned long offset);
+unsigned long _find_first_bit_le(const unsigned long *p, unsigned long size);
+unsigned long _find_next_bit_le(const unsigned long *p,
+				 unsigned long size, unsigned long offset);
+
+extern void __ashldi3(void);
+extern void __ashrdi3(void);
+extern void __divsi3(void);
+extern void __lshrdi3(void);
+extern void __modsi3(void);
+extern void __muldi3(void);
+extern void __ucmpdi2(void);
+extern void __udivsi3(void);
+extern void __umodsi3(void);
+extern void __do_div64(void);
+extern void __bswapsi2(void);
+extern void __bswapdi2(void);
+
+extern void __aeabi_idiv(void);
+extern void __aeabi_idivmod(void);
+extern void __aeabi_lasr(void);
+extern void __aeabi_llsl(void);
+extern void __aeabi_llsr(void);
+extern void __aeabi_lmul(void);
+extern void __aeabi_uidiv(void);
+extern void __aeabi_uidivmod(void);
+extern void __aeabi_ulcmp(void);
+
+	/* bitops (arch/arm/lib/{set,clear,testset,testclear,change,testchange}bit.S) */
+EXPORT_SYMBOL(_set_bit);
+EXPORT_SYMBOL(_test_and_set_bit);
+EXPORT_SYMBOL(_sync_test_and_set_bit);
+EXPORT_SYMBOL(_clear_bit);
+EXPORT_SYMBOL(_test_and_clear_bit);
+EXPORT_SYMBOL(_sync_test_and_clear_bit);
+EXPORT_SYMBOL(_change_bit);
+EXPORT_SYMBOL(_test_and_change_bit);
+EXPORT_SYMBOL(_sync_test_and_change_bit);
+
+	/* find-bit, LE build (arch/arm/lib/findbit.S) */
+EXPORT_SYMBOL(_find_first_zero_bit_le);
+EXPORT_SYMBOL(_find_next_zero_bit_le);
+EXPORT_SYMBOL(_find_first_bit_le);
+EXPORT_SYMBOL(_find_next_bit_le);
+
+	/* gcc and AEABI 32-bit div/mod helpers (arch/arm/lib/lib1funcs.S) */
+EXPORT_SYMBOL(__divsi3);
+EXPORT_SYMBOL(__modsi3);
+EXPORT_SYMBOL(__udivsi3);
+EXPORT_SYMBOL(__umodsi3);
+EXPORT_SYMBOL(__aeabi_idiv);
+EXPORT_SYMBOL(__aeabi_uidiv);
+EXPORT_SYMBOL(__aeabi_idivmod);
+EXPORT_SYMBOL(__aeabi_uidivmod);
+
+	/* gcc 64-bit helpers (arch/arm/lib/{ashldi3,ashrdi3,lshrdi3,muldi3,ucmpdi2,bswapsdi2}.S) */
+EXPORT_SYMBOL(__do_div64);
+EXPORT_SYMBOL(__ashldi3);
+EXPORT_SYMBOL(__ashrdi3);
+EXPORT_SYMBOL(__lshrdi3);
+EXPORT_SYMBOL(__muldi3);
+EXPORT_SYMBOL(__ucmpdi2);
+EXPORT_SYMBOL(__aeabi_llsl);
+EXPORT_SYMBOL(__aeabi_lasr);
+EXPORT_SYMBOL(__aeabi_llsr);
+EXPORT_SYMBOL(__aeabi_lmul);
+EXPORT_SYMBOL(__aeabi_ulcmp);
+EXPORT_SYMBOL(__bswapsi2);
+EXPORT_SYMBOL(__bswapdi2);
