diff --git a/arch/arm/um/os-Linux/mcontext.c b/arch/arm/um/os-Linux/mcontext.c
new file mode 100644
index 000000000..925634950
--- /dev/null
+++ b/arch/arm/um/os-Linux/mcontext.c
@@ -0,0 +1,218 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * mcontext <-> uml_pt_regs conversion for ARCH=um SUBARCH=arm.
+ *
+ * This is host-side code: it manipulates the signal frame the *host* built for
+ * a stub process. On an arm host the mcontext is the named-field sigcontext --
+ * plain named members, no gregs[] array to index -- and the VFP state, where
+ * the host kernel has any, does not live in the mcontext at all: it is a
+ * magic-record chain in the ucontext's uc_regspace[] extension area, after
+ * the sigmask, so reaching it means stepping back to the parent ucontext
+ * first.
+ */
+#include <stddef.h>
+#include <linux/errno.h>
+#include <linux/string.h>
+#include <sys/ucontext.h>
+#include <sysdep/ptrace.h>
+#include <sysdep/mcontext.h>
+#include <sysdep/stub-data.h>
+#include <stub-data.h>
+#include <arch.h>
+
+void get_regs_from_mc(struct uml_pt_regs *regs, mcontext_t *mc)
+{
+	regs->gp[HOST_R0]  = mc->arm_r0;
+	regs->gp[HOST_R1]  = mc->arm_r1;
+	regs->gp[HOST_R2]  = mc->arm_r2;
+	regs->gp[HOST_R3]  = mc->arm_r3;
+	regs->gp[HOST_R4]  = mc->arm_r4;
+	regs->gp[HOST_R5]  = mc->arm_r5;
+	regs->gp[HOST_R6]  = mc->arm_r6;
+	regs->gp[HOST_R7]  = mc->arm_r7;
+	regs->gp[HOST_R8]  = mc->arm_r8;
+	regs->gp[HOST_R9]  = mc->arm_r9;
+	regs->gp[HOST_R10] = mc->arm_r10;
+	regs->gp[HOST_FP]  = mc->arm_fp;
+	regs->gp[HOST_IP]  = mc->arm_ip;
+	regs->gp[HOST_SP]  = mc->arm_sp;
+	regs->gp[HOST_LR]  = mc->arm_lr;
+	regs->gp[HOST_PC]  = mc->arm_pc;
+	regs->gp[HOST_CPSR] = mc->arm_cpsr;
+
+	/*
+	 * r7 holds the syscall number at the SVC that trapped into the
+	 * seccomp filter. Unlike the ptrace path there is no NT-style regset
+	 * to consult here -- the stub is stopped in its own SIGSYS handler,
+	 * not in a syscall-entry stop -- and at that point r7 is
+	 * authoritative. The original first argument is already a member of
+	 * the sigcontext, so it comes along with the copy above.
+	 */
+	regs->gp[HOST_SYSCALL_NR] = mc->arm_r7;
+	regs->gp[HOST_ORIG_R0] = mc->arm_r0;
+}
+
+void get_mc_from_regs(struct uml_pt_regs *regs, mcontext_t *mc,
+		      int single_stepping)
+{
+	mc->arm_r0  = regs->gp[HOST_R0];
+	mc->arm_r1  = regs->gp[HOST_R1];
+	mc->arm_r2  = regs->gp[HOST_R2];
+	mc->arm_r3  = regs->gp[HOST_R3];
+	mc->arm_r4  = regs->gp[HOST_R4];
+	mc->arm_r5  = regs->gp[HOST_R5];
+	mc->arm_r6  = regs->gp[HOST_R6];
+	mc->arm_r7  = regs->gp[HOST_R7];
+	mc->arm_r8  = regs->gp[HOST_R8];
+	mc->arm_r9  = regs->gp[HOST_R9];
+	mc->arm_r10 = regs->gp[HOST_R10];
+	mc->arm_fp  = regs->gp[HOST_FP];
+	mc->arm_ip  = regs->gp[HOST_IP];
+	mc->arm_sp  = regs->gp[HOST_SP];
+	mc->arm_lr  = regs->gp[HOST_LR];
+	mc->arm_pc  = regs->gp[HOST_PC];
+	mc->arm_cpsr = regs->gp[HOST_CPSR];
+
+	/*
+	 * single_stepping is ignored, and must be.
+	 *
+	 * x86 implements it here by setting EFLAGS.TF in the frame the stub
+	 * is about to sigreturn to. arm32's CPSR has no user-writable
+	 * single-step bit at all: the host does single-stepping through the
+	 * PTRACE_SINGLESTEP resume path, and the instruction state bits that
+	 * are writable (T) are not it. There is no way to arm a single step
+	 * from inside the stub.
+	 *
+	 * Single-stepping a guest therefore requires the ptrace path, where
+	 * PTRACE_SINGLESTEP asks the host kernel to do it. arch/um/kernel/ptrace.c
+	 * puts a task that wants single-stepping onto that path; nothing is
+	 * silently dropped here.
+	 */
+}
+
+void mc_set_rip(void *_mc, void *target)
+{
+	mcontext_t *mc = _mc;
+
+	mc->arm_pc = (unsigned long)target;
+}
+
+struct um_user_vfp {
+	unsigned long long fpregs[32];
+	unsigned long fpscr;
+};
+
+/*
+ * The VFP record, spelled out rather than taken from the host's
+ * <asm/sigcontext.h> so this file does not depend on which host headers
+ * happen to be installed. It matches struct vfp_sigframe in the arm kernel:
+ * the signal-frame ufp is the 264-byte form -- the 260-byte PTRACE
+ * GETVFPREGS/SETVFPREGS payload plus 4 bytes of trailing pad -- followed by
+ * the 12-byte user_vfp_exc, all padded out to a multiple of 8.
+ */
+struct um_vfp_sigframe {
+	unsigned long magic;
+	unsigned long size;
+	struct um_user_vfp ufp;
+	unsigned long fpexc;
+	unsigned long fpinst;
+	unsigned long fpinst2;
+} __attribute__((__aligned__(8)));
+
+/*
+ * Locate the VFP record in the ucontext's uc_regspace[] chain.
+ *
+ * The host kernel lays out one record per coprocessor it preserves, in a
+ * config-dependent order (an IWMMXT block may come first when the host has
+ * it), terminated by a zero. Bounded on both the individual record sizes
+ * and the buffer length: this walks a structure the guest process could have
+ * scribbled on.
+ */
+static struct um_vfp_sigframe *find_vfp(ucontext_t *uc)
+{
+	unsigned char *p = (unsigned char *)uc->uc_regspace;
+	unsigned long left = sizeof(uc->uc_regspace);
+
+	while (left >= sizeof(struct um_vfp_sigframe)) {
+		struct um_vfp_sigframe *h =
+			(struct um_vfp_sigframe *)p;
+
+		if (h->magic == 0 || h->size == 0)
+			return NULL;
+		if (h->size > left)
+			return NULL;
+		if (h->magic == UM_VFP_MAGIC && h->size >= sizeof(*h))
+			return h;
+		p += h->size;
+		left -= h->size;
+	}
+	return NULL;
+}
+
+int get_stub_state(struct uml_pt_regs *regs, struct stub_data *data,
+		   unsigned long *fp_size_out)
+{
+	struct um_vfp_sigframe *vfp;
+	mcontext_t *mcontext;
+	ucontext_t *uc;
+
+	/* mctx_offset is verified by wait_stub_done_seccomp */
+	mcontext = (void *)&data->sigstack[data->mctx_offset];
+
+	get_regs_from_mc(regs, mcontext);
+
+	/*
+	 * Guest TLS needs nothing here at all: R8 is a member of the
+	 * sigcontext, so the host put it in the frame and the copy above
+	 * picked it up. That is the difference from arm64, where TPIDR_EL0
+	 * is not in the mcontext and the stub had to capture it on the way in.
+	 */
+
+	if (host_fp_size) {
+		uc = (ucontext_t *)((char *)mcontext -
+				    offsetof(ucontext_t, uc_mcontext));
+		vfp = find_vfp(uc);
+		if (vfp)
+			memcpy(regs->fp, &vfp->ufp, host_fp_size);
+	}
+
+	if (fp_size_out)
+		*fp_size_out = host_fp_size;
+
+	return 0;
+}
+
+int set_stub_state(struct uml_pt_regs *regs, struct stub_data *data,
+		   int single_stepping)
+{
+	struct um_vfp_sigframe *vfp;
+	mcontext_t *mcontext;
+	ucontext_t *uc;
+
+	/* mctx_offset is verified by wait_stub_done_seccomp */
+	mcontext = (void *)&data->sigstack[data->mctx_offset];
+
+	if ((unsigned long)mcontext < (unsigned long)data->sigstack ||
+	    (unsigned long)mcontext >
+			(unsigned long)data->sigstack +
+			sizeof(data->sigstack) - sizeof(*mcontext))
+		return -EINVAL;
+
+	get_mc_from_regs(regs, mcontext, single_stepping);
+
+	if (host_fp_size) {
+		uc = (ucontext_t *)((char *)mcontext -
+				    offsetof(ucontext_t, uc_mcontext));
+		vfp = find_vfp(uc);
+		/*
+		 * The host built the frame, so the record is there when host
+		 * FP state exists at all. If it is not -- a malformed or a
+		 * host that dropped it -- the stub comes back with whatever
+		 * FP state it already had rather than being zeroed.
+		 */
+		if (vfp)
+			memcpy(&vfp->ufp, regs->fp, host_fp_size);
+	}
+
+	return 0;
+}
diff --git a/arch/arm/um/os-Linux/registers.c b/arch/arm/um/os-Linux/registers.c
new file mode 100644
index 000000000..17b8555b1
--- /dev/null
+++ b/arch/arm/um/os-Linux/registers.c
@@ -0,0 +1,233 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Host register access for ARCH=um SUBARCH=arm.
+ *
+ * arm uses the classic PTRACE_GETREGS/PTRACE_SETREGS pair: one 72-byte
+ * struct user_regs_struct, read and written whole. Unlike arm64 there is no
+ * regset dance at all -- the register block is all the host ever exposes --
+ * and the VFP block, where the host has any, comes as a fixed 260-byte
+ * PTRACE_GETVFPREGS/SETVFPREGS payload.
+ */
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ptrace.h>
+#include <sys/mman.h>
+#include <linux/elf.h>
+#include <sysdep/archsetjmp.h>
+#include <sysdep/ptrace.h>
+#include <sysdep/ptrace_user.h>
+#include <registers.h>
+
+#ifndef ARM_VFPREGS_SIZE
+#define ARM_VFPREGS_SIZE	(32 * 8 + 4)
+#endif
+
+unsigned long host_fp_size;
+
+int get_fp_registers(int pid, unsigned long *regs)
+{
+	/*
+	 * The payload is ARM_VFPREGS_SIZE bytes, which is 65 x unsigned int
+	 * on this target and therefore packs exactly into the 65-word
+	 * unsigned long array UGL keeps in uml_pt_regs.fp.
+	 */
+	if (ptrace(PTRACE_GETVFPREGS, pid, NULL, regs) < 0)
+		return -errno;
+	return 0;
+}
+
+int put_fp_registers(int pid, unsigned long *regs)
+{
+	if (ptrace(PTRACE_SETVFPREGS, pid, NULL, regs) < 0)
+		return -errno;
+	return 0;
+}
+
+/*
+ * Read the guest's general-purpose registers.
+ *
+ * The whole 72-byte host regset fills slots 0..17 of gp[] one-to-one. The
+ * one slot above it is synthesised here:
+ *
+ *   HOST_SYSCALL_NR  the in-flight syscall number, copied from r7 while the
+ *                    stub is stopped for a syscall. UGL only inspects the
+ *                    registers on the syscall-stop paths, so r7 is the
+ *                    number there; at any other stop it would just be a
+ *                    scratch register, which is exactly why the value has to
+ *                    be captured into its own slot rather than read from r7
+ *                    later.
+ *
+ *   HOST_ORIG_R0     already in the buffer: the host kernel keeps the
+ *                    original first argument at ureg[17], unlike arm64
+ *                    where x0 had to be copied in from its current value.
+ */
+int get_host_regs(int pid, unsigned long *regs)
+{
+	if (ptrace(PTRACE_GETREGS, pid, NULL, regs) < 0)
+		return -errno;
+
+	regs[HOST_SYSCALL_NR] = regs[HOST_R7];
+
+	return 0;
+}
+
+/*
+ * Write the guest's general-purpose registers back.
+ *
+ * PTRACE_SETREGS takes the 72-byte regset only, so the synthesised slot
+ * above it is never pushed to the host, and that is deliberate: writing r7
+ * is how UML redirects the next svc, and UPT_RESTART_SYSCALL() already puts
+ * the number there through the ordinary slot.
+ *
+ * TLS needs no separate transfer unlike arm64: R8 is a member of the regset,
+ * so restoring the whole block restores it.
+ */
+int put_host_regs(int pid, unsigned long *regs)
+{
+	if (ptrace(PTRACE_SETREGS, pid, NULL, regs) < 0)
+		return -errno;
+	return 0;
+}
+
+/*
+ * The wrapper the generic skas path calls before PTRACE_CONT to put the
+ * stub's registers back the way do_syscall_stub found them
+ * (arch/um/os-Linux/skas/mem.c); the subarch supplies it. For arm it is
+ * just put_host_regs: the regset goes back as one 72-byte block, and the
+ * synthetic SYSCALL_NR slot above it stays on the UGL side.
+ */
+int ptrace_setregs(long pid, unsigned long *regs_in)
+{
+	return put_host_regs((int)pid, regs_in);
+}
+
+/*
+ * Inspect and rewrite the syscall a stopped tracee is about to make.
+ */
+long ptrace_get_syscall_nr(int pid)
+{
+	/*
+	 * The number is r7, and at a syscall stop r7 is authoritative, so it
+	 * can be read out of the ordinary user area. Offsets are in bytes
+	 * into the 72-byte regset; ureg[7] is at 28.
+	 */
+	unsigned int nr;
+
+	if (ptrace(PTRACE_PEEKUSER, pid, 7 * sizeof(unsigned int), &nr) < 0) {
+		errno = EIO;
+		return -1;
+	}
+	return nr;
+}
+
+int ptrace_set_syscall_nr(int pid, long nr)
+{
+	unsigned long regs[UM_MAX_REG_NR];
+
+	/*
+	 * arm has no "run no syscall" number, but it has something better for
+	 * this purpose: the kernel's svc dispatcher returns -ENOSYS for a
+	 * number outside the table, so writing -1 into r7 cancels the call.
+	 */
+	if (nr < 0)
+		nr = -1;
+
+	if (get_host_regs(pid, regs) < 0)
+		return -errno;
+
+	regs[HOST_R7] = (unsigned long)nr;
+
+	if (put_host_regs(pid, regs) < 0)
+		return -errno;
+
+	return 0;
+}
+
+int ptrace_set_syscall_ret(int pid, long val)
+{
+	/*
+	 * The return value is just r0, but the host's PTRACE_PEEKUSER/POKEUSER
+	 * are word-granular, so read the block, patch the word and write it
+	 * back.
+	 */
+	unsigned long regs[UM_MAX_REG_NR];
+	int err;
+
+	err = get_host_regs(pid, regs);
+	if (err)
+		return err;
+
+	regs[HOST_R0] = (unsigned long)val;
+
+	err = put_host_regs(pid, regs);
+	if (err)
+		return err;
+
+	return 0;
+}
+
+const char *ptrace_reg_name(int idx)
+{
+	static const char * const name[] = {
+		"R0",  "R1",  "R2",  "R3",  "R4",  "R5",  "R6",  "R7",
+		"R8",  "R9",  "R10", "FP",  "IP",  "SP",  "LR",  "PC",
+		"CPSR", "ORIG_R0",
+	};
+
+	if (idx >= HOST_R0 && idx <= HOST_ORIG_R0)
+		return name[idx - HOST_R0];
+	if (idx == HOST_SYSCALL_NR)
+		return "SYSCALL_NR";
+	return "";
+}
+
+/*
+ * Size the FP block once, against a live stub process.
+ *
+ * PTRACE_GETVFPREGS, deliberately. It yields a fixed ARM_VFPREGS_SIZE-byte
+ * payload -- struct user_vfp -- and every consumer of uml_pt_regs.fp in this
+ * port reads it as exactly that: the ptrace regset view in
+ * arch/arm/um/ptrace.c, the signal-frame marshalling in arch/arm/um/signal.c,
+ * and the stub-state copies in os-Linux/mcontext.c.
+ *
+ * Unlike arm64 there is no buffer to size: the payload is a constant 260
+ * bytes on every arm host that has VFP at all, and there is no SVE-style
+ * header whose layout depends on vector length. The probe only answers
+ * "does this host have VFP", in which case the guest is told it does; on a
+ * host without VFP the request fails and the guest is told it does not have
+ * floating point, which is what it will actually get.
+ */
+int arch_init_registers(int pid)
+{
+	unsigned long regs[ARM_VFPREGS_SIZE / sizeof(unsigned long)];
+
+	if (get_fp_registers(pid, regs) < 0)
+		host_fp_size = 0;
+	else
+		host_fp_size = ARM_VFPREGS_SIZE;
+
+	return 0;
+}
+
+unsigned long get_thread_reg(int reg, jmp_buf *buf)
+{
+	switch (reg) {
+	case HOST_PC:
+		/*
+		 * A longjmp resumes at the saved return address, so for a
+		 * jmp_buf the link register *is* the instruction pointer.
+		 */
+		return buf[0]->__lr;
+	case HOST_SP:
+		return buf[0]->__sp;
+	case HOST_LR:
+		return buf[0]->__lr;
+	case HOST_FP:
+		return buf[0]->__r11;
+	default:
+		printk(UM_KERN_ERR "get_thread_reg - unknown register %d\n",
+		       reg);
+		return 0;
+	}
+}
diff --git a/arch/arm/um/ptrace.c b/arch/arm/um/ptrace.c
new file mode 100644
index 000000000..548afb835
--- /dev/null
+++ b/arch/arm/um/ptrace.c
@@ -0,0 +1,250 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ptrace support for ARCH=um SUBARCH=arm.
+ *
+ * The "user area" a debugger sees through PTRACE_PEEKUSER/POKEUSER is simply
+ * the 72-byte struct user_regs_struct: ureg[0..17] -- r0-r10, fp, ip, sp,
+ * lr, pc, cpsr, orig_r0. That makes register lookup a plain division by
+ * the word size rather than the offset table x86 needs, because arm32 has
+ * no segment registers, no debug-register block in the user area, and the
+ * original first argument is an ordinary member of the block.
+ */
+#include <linux/mm.h>
+#include <linux/sched.h>
+#include <linux/errno.h>
+#include <linux/elf.h>
+#include <linux/regset.h>
+#include <linux/uaccess.h>
+#include <asm/ptrace.h>
+#include <registers.h>
+
+static inline int reg_index(int regno)
+{
+	return regno / sizeof(unsigned long);
+}
+
+int putreg(struct task_struct *child, int regno, unsigned long value)
+{
+	int idx;
+
+	if (regno < 0 || regno >= MAX_REG_OFFSET ||
+	    (regno % sizeof(unsigned long)))
+		return -EIO;
+
+	idx = reg_index(regno);
+
+	if (idx == HOST_CPSR) {
+		unsigned long old = child->thread.regs.regs.gp[HOST_CPSR];
+
+		child->thread.regs.regs.gp[HOST_CPSR] =
+			(old & ~UM_CPSR_WRITABLE) | (value & UM_CPSR_WRITABLE);
+		return 0;
+	}
+
+	child->thread.regs.regs.gp[idx] = value;
+	return 0;
+}
+
+unsigned long getreg(struct task_struct *child, int regno)
+{
+	if (regno < 0 || regno >= MAX_REG_OFFSET ||
+	    (regno % sizeof(unsigned long)))
+		return 0;
+
+	return child->thread.regs.regs.gp[reg_index(regno)];
+}
+
+int poke_user(struct task_struct *child, long addr, long data)
+{
+	if ((addr & (sizeof(unsigned long) - 1)) || addr < 0)
+		return -EIO;
+
+	if (addr < MAX_REG_OFFSET)
+		return putreg(child, addr, data);
+
+	/*
+	 * arm32 exposes no debug registers through the user area -- hardware
+	 * breakpoints and watchpoints are separate regsets (NT_ARM_HW_BREAK,
+	 * NT_ARM_HW_WATCH), which UML does not implement. The synthesised
+	 * syscall-number slot at MAX_REG_OFFSET is UML's own bookkeeping; the
+	 * host kernel will never install it, so it is not visible either.
+	 */
+	return -EIO;
+}
+
+int peek_user(struct task_struct *child, long addr, long data)
+{
+	unsigned long tmp = 0;
+
+	if ((addr & (sizeof(unsigned long) - 1)) || addr < 0)
+		return -EIO;
+
+	if (addr < MAX_REG_OFFSET)
+		tmp = getreg(child, addr);
+
+	return put_user(tmp, (unsigned long __user *) data);
+}
+
+static int genregs_get(struct task_struct *target,
+		       const struct user_regset *regset,
+		       struct membuf to)
+{
+	int reg;
+
+	for (reg = 0; to.left; reg++)
+		membuf_store(&to, getreg(target, reg * sizeof(unsigned long)));
+	return 0;
+}
+
+static int genregs_set(struct task_struct *target,
+		       const struct user_regset *regset,
+		       unsigned int pos, unsigned int count,
+		       const void *kbuf, const void __user *ubuf)
+{
+	int ret = 0;
+
+	if (kbuf) {
+		const unsigned long *k = kbuf;
+
+		while (count >= sizeof(*k) && !ret) {
+			ret = putreg(target, pos, *k++);
+			count -= sizeof(*k);
+			pos += sizeof(*k);
+		}
+	} else {
+		const unsigned long __user *u = ubuf;
+
+		while (count >= sizeof(*u) && !ret) {
+			unsigned long word;
+
+			ret = __get_user(word, u++);
+			if (ret)
+				break;
+			ret = putreg(target, pos, word);
+			count -= sizeof(*u);
+			pos += sizeof(*u);
+		}
+	}
+	return ret;
+}
+
+static int fpregs_active(struct task_struct *target,
+			 const struct user_regset *regset)
+{
+	return regset->n;
+}
+
+static int fpregs_get(struct task_struct *target,
+		      const struct user_regset *regset,
+		      struct membuf to)
+{
+	void *fpregs = task_pt_regs(target)->regs.fp;
+
+	membuf_write(&to, fpregs, regset->size * regset->n);
+	return 0;
+}
+
+static int fpregs_set(struct task_struct *target,
+		      const struct user_regset *regset,
+		      unsigned int pos, unsigned int count,
+		      const void *kbuf, const void __user *ubuf)
+{
+	void *fpregs = task_pt_regs(target)->regs.fp;
+
+	return user_regset_copyin(&pos, &count, &kbuf, &ubuf,
+				  fpregs, 0, regset->size * regset->n);
+}
+
+static struct user_regset uml_regsets[] __ro_after_init = {
+	[REGSET_GENERAL] = {
+		USER_REGSET_NOTE_TYPE(PRSTATUS),
+		.n		= sizeof(struct user_regs_struct) / sizeof(long),
+		.size		= sizeof(long),
+		.align		= sizeof(long),
+		.regset_get	= genregs_get,
+		.set		= genregs_set,
+	},
+	[REGSET_FP] = {
+		USER_REGSET_NOTE_TYPE(ARM_VFP),
+		/*
+		 * .n is fixed up at boot from host_fp_size. arm32's VFP
+		 * state is a fixed-size payload, so this only ever comes
+		 * out as ARM_VFPREGS_SIZE / 4 or zero.
+		 */
+		.size		= sizeof(long),
+		.align		= sizeof(long),
+		.active		= fpregs_active,
+		.regset_get	= fpregs_get,
+		.set		= fpregs_set,
+	},
+};
+
+static const struct user_regset_view user_uml_view = {
+	.name = "arm", .e_machine = EM_ARM,
+	.regsets = uml_regsets, .n = ARRAY_SIZE(uml_regsets)
+};
+
+const struct user_regset_view *
+task_user_regset_view(struct task_struct *tsk)
+{
+	return &user_uml_view;
+}
+
+/*
+ * arm32 defines legacy ptrace requests that UML can serve for the ones that
+ * name the state UML preserves, and refuses for the rest.
+ *
+ * PTRACE_GETVFPREGS / PTRACE_SETVFPREGS move the VFP block in place, the way
+ * old arm glibc and gdb still move it. The payload is the ARM_VFPREGS_SIZE
+ * bytes UGL keeps in uml_pt_regs.fp -- the same 260 bytes the host's own
+ * ptrace(2) would hand out.
+ *
+ * Not served, and deliberately so:
+ *   PTRACE_GETFPREGS/SETFPREGS   FPA state; armv7 has no FPA and UML does
+ *                               not preserve any such thing.
+ *   PTRACE_GETWMMXREGS/...      WMMX, same story.
+ *   PTRACE_GETCRUNCHREGS/...    obsolete crunch, same story.
+ *   PTRACE_GETHBPREGS/SETHBPREGS hardware breakpoints; UML does not
+ *                                implement them for the guest.
+ *   PTRACE_SET_SYSCALL          an old OABI-style way to redirect a syscall
+ *                               that UML has no use for: the redirect and
+ *                               the cancel happen through the register view.
+ */
+long subarch_ptrace(struct task_struct *child, long request,
+		    unsigned long addr, unsigned long data)
+{
+	void __user *ptr = (void __user *)data;
+
+	if (host_fp_size) {
+		void *fp = task_pt_regs(child)->regs.fp;
+		unsigned long count = host_fp_size;
+
+		switch (request) {
+		case PTRACE_GETVFPREGS:
+			return copy_to_user(ptr, fp, count) ? -EFAULT : 0;
+		case PTRACE_SETVFPREGS:
+			return copy_from_user(fp, ptr, count) ? -EFAULT : 0;
+		}
+	} else {
+		/*
+		 * The host has no VFP state at all, so a request for it is
+		 * not supported rather than failing on a copy.
+		 */
+		switch (request) {
+		case PTRACE_GETVFPREGS:
+		case PTRACE_SETVFPREGS:
+			return -ENODEV;
+		}
+	}
+
+	return -EIO;
+}
+
+static int __init init_regset_fp_info(void)
+{
+	uml_regsets[REGSET_FP].n =
+		host_fp_size / uml_regsets[REGSET_FP].size;
+
+	return 0;
+}
+arch_initcall(init_regset_fp_info);
diff --git a/arch/arm/um/setjmp_arm.S b/arch/arm/um/setjmp_arm.S
new file mode 100644
index 000000000..38796d7f9
--- /dev/null
+++ b/arch/arm/um/setjmp_arm.S
@@ -0,0 +1,88 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * setjmp/longjmp for ARCH=um SUBARCH=arm.
+ *
+ * UML uses its own setjmp/longjmp for kernel-side context switching rather
+ * than libc's -- arch/um/Makefile renames the symbols to kernel_setjmp /
+ * kernel_longjmp to keep libc's out of the way. libc's versions are
+ * unsuitable because they may mangle the saved SP and PC with a
+ * per-process pointer guard, and glibc's siglongjmp variant touches the
+ * signal mask; UML needs a plain, predictable register save.
+ *
+ * The buffer layout matches struct __jmp_buf in
+ * arch/arm/um/shared/sysdep/archsetjmp.h:
+ *
+ *	 0	r4
+ *	 4	r5
+ *	 8	r6
+ *	12	r7
+ *	16	r8
+ *	20	r9
+ *	24	r10
+ *	28	r11
+ *	32	sp
+ *	36	lr (return address)
+ *
+ * That is exactly the AAPCS callee-saved set for the soft-float ABI: r4-r11,
+ * the link register and SP. No VFP registers are in it on purpose: UML is
+ * built with -mfloat-abi=soft, so the ABI these functions follow promises no
+ * callee saves any vector register, and the guest's VFP state never passes
+ * through here in any case -- it lives in the stub's mcontext and in
+ * uml_pt_regs.fp.
+ *
+ * The stub and this file are plain 32-bit ARM (no Thumb, no position
+ * independence tricks needed): the binary's svc #0 system calls and the
+ * host-resume code both require it. Pin the state explicitly, because the
+ * assembler's default state is a toolchain property, not a source one --
+ * the armel cross compilers ship Thumb as the default, and an encoded
+ * Thumb state here would put the svc #0 the stub steps over in a shape
+ * its resume check does not recognise.
+ */
+
+	.arm
+	.text
+	.align 2
+	.globl kernel_setjmp
+	.type kernel_setjmp, %function
+kernel_setjmp:
+	stmia	r0, {r4-r11}
+
+	/*
+	 * SP cannot be an operand of stmia, so route it through a scratch
+	 * register. r2 is caller-saved, so clobbering it is free.
+	 */
+	mov	r2, sp
+	str	r2, [r0, #32]
+
+	mov	r2, lr
+	str	r2, [r0, #36]
+
+	mov	r0, #0
+	bx	lr
+
+	.size kernel_setjmp, .-kernel_setjmp
+
+	.text
+	.align 2
+	.globl kernel_longjmp
+	.type kernel_longjmp, %function
+kernel_longjmp:
+	ldmia	r0, {r4-r11}
+
+	ldr	sp, [r0, #32]
+	ldr	lr, [r0, #36]
+
+	/*
+	 * longjmp(buf, 0) must appear to setjmp as a return of 1, otherwise
+	 * the caller cannot distinguish it from the original setjmp.
+	 */
+	cmp	r1, #0
+	movne	r0, r1
+	moveq	r0, #1
+
+	bx	lr
+
+	.size kernel_longjmp, .-kernel_longjmp
+
+/* UML's binary is an ordinary ELF executable; keep the stack non-executable. */
+	.section .note.GNU-stack,"",%progbits
diff --git a/arch/arm/um/shared/sysdep/archsetjmp.h b/arch/arm/um/shared/sysdep/archsetjmp.h
new file mode 100644
index 000000000..b7ce76850
--- /dev/null
+++ b/arch/arm/um/shared/sysdep/archsetjmp.h
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * UML's private jmp_buf for arm32.
+ *
+ * UML cannot use libc setjmp()/longjmp() for kernel-side context switching --
+ * arch/um/Makefile renames them to kernel_setjmp/kernel_longjmp precisely to
+ * keep libc's versions (which may touch the signal mask or a stack guard) out
+ * of the way. This is the matching buffer layout; see setjmp_arm.S.
+ *
+ * AAPCS soft-float callee-saved state: r4-r11, LR and SP. The hard-float
+ * variant of the ABI saves d8-d15 as well, but UML is built with
+ * -mfloat-abi=soft, so no vector register is ever callee-saved and none is
+ * kept here.
+ */
+#ifndef _KLIBC_ARCHSETJMP_H
+#define _KLIBC_ARCHSETJMP_H
+
+struct __jmp_buf {
+	unsigned long __r4;
+	unsigned long __r5;
+	unsigned long __r6;
+	unsigned long __r7;
+	unsigned long __r8;
+	unsigned long __r9;
+	unsigned long __r10;
+	unsigned long __r11;
+	unsigned long __sp;
+	unsigned long __lr;	/* link register -- resume address */
+};
+
+typedef struct __jmp_buf jmp_buf[1];
+
+unsigned long get_thread_reg(int reg, jmp_buf *buf);
+
+/*
+ * get_thread_reg() asks for HOST_PC/HOST_SP of a saved context. There is no
+ * separate saved PC: a longjmp resumes at the return address in LR, so that
+ * is what "IP" means for a jmp_buf.
+ */
+#define JB_IP __lr
+#define JB_SP __sp
+
+/*
+ * Bytes to leave below the top of a fresh kernel stack: none.
+ *
+ * x86 reserves one word to emulate the return address `call` pushes, so the
+ * callee sees the alignment its ABI expects. arm has no pushed return
+ * address -- the link register carries it -- and AAPCS only requires SP to be
+ * 8-byte aligned when returning from a function prologue, so there is
+ * nothing to reserve.
+ */
+#define ARCH_INIT_SP_RESERVE	0
+
+#endif /* _KLIBC_ARCHSETJMP_H */
diff --git a/arch/arm/um/shared/sysdep/faultinfo.h b/arch/arm/um/shared/sysdep/faultinfo.h
new file mode 100644
index 000000000..fecb95025 100644
--- /dev/null
+++ b/arch/arm/um/shared/sysdep/faultinfo.h
@@ -0,0 +1,103 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Fault information for ARCH=um SUBARCH=arm.
+ */
+#ifndef __FAULTINFO_ARM_H
+#define __FAULTINFO_ARM_H
+
+/*
+ * The sigcontext delivers the fault status register in error_code. The
+ * host's fault path stores the FSR of the fault in thread_struct right
+ * before it raises the signal (arch/arm/mm/fault.c, tsk->thread.error_code),
+ * and the signal code copies that field into the frame, so error_code is
+ * the FSR of the fault just delivered, not a stale value. For a data
+ * abort, bit 11 (FSR_WRITE) says the access was a write, and bit 13
+ * (FSR_CM) takes it back when the abort came from cache maintenance
+ * instead of a real store. That pair is the arm equivalent of x86's
+ * page-fault error code bit 1, and it is what makes copy-on-write
+ * distinguishable from a plain read fault.
+ */
+#define UM_FSR_WRITE	0x0800
+#define UM_FSR_CM	0x2000
+
+struct faultinfo {
+	unsigned int ec;
+	unsigned long addr;
+};
+
+#define FAULT_WRITE(fi)						\
+	(((fi).ec & UM_FSR_WRITE) && !((fi).ec & UM_FSR_CM))
+#define FAULT_ADDRESS(fi) ((fi).addr)
+/*
+ * The architecture's own description of why the fault happened: the FSR,
+ * which an arm developer reading a segfault report will expect to see.
+ */
+#define FAULT_ERROR_CODE(fi) ((fi).ec)
+
+/*
+ * "Fixable" means the fault is a translation/permission problem UML can
+ * resolve by populating the guest page tables, rather than something
+ * structural. On arm both translation and permission faults look the
+ * same in the FSR, and either is just an ordinary not-yet-faulted-in
+ * guest page.
+ */
+#define SEGV_IS_FIXABLE(fi) 1
+
+#define PTRACE_FULL_FAULTINFO 1
+
+/*
+ * Pull the two fault fields out of the host's signal frame.
+ *
+ * Unlike aarch64's, arm's sigcontext carries no fault address at all: the
+ * kernel's SEGV delivery hands the address to the handler only in the
+ * siginfo that accompanies the frame. Every caller of this macro holds
+ * that siginfo under the name `si` -- the two generic ones are
+ * sig_handler_common() in arch/um/os-Linux/signal.c (a parameter) and the
+ * SKAS stub-signal path in arch/um/os-Linux/skas/process.c (a local,
+ * populated from the stub's sigstack just above the call) -- and the
+ * subarch's own is stub_segv_handler() in arch/arm/um/stub_segv.c, whose
+ * parameter is named accordingly. The macro therefore expands a reference
+ * to `si`; a caller that does not have one fails to compile rather than
+ * fill in a wrong address. That `si` is dereferenced through the glibc
+ * siginfo_t it actually is: UML's own tagged struct siginfo is only
+ * forward-declared in host-side TUs, so a direct dereference of it is
+ * ill-formed, and every caller's `si` points at a glibc siginfo_t whose
+ * si_addr sits at the same offset.
+ */
+#define GET_FAULTINFO_FROM_MC(fi, mc)					\
+	do {								\
+		siginfo_t *__si = (siginfo_t *)(si);			\
+		(fi).ec = (unsigned int)(mc)->error_code;		\
+		(fi).addr = (unsigned long)(void *)__si->si_addr;	\
+	} while (0)
+
+/*
+ * Record a landing pad for a fault taken inside __get_kernel_nofault /
+ * __put_kernel_nofault. The SIGSEGV handler in arch/um/kernel/trap.c
+ * redirects the mcontext PC to thread.segv_continue, so control resumes
+ * at label 1 with _faulted set.
+ *
+ * Local numeric labels are used rather than x86's "%=" name mangling: the
+ * arm assembler resolves 1f/1b per-instance, so nothing has to be
+ * uniquified and the macro stays safe when inlined more than once in a
+ * function.
+ */
+#define ___backtrack_faulted(_faulted)					\
+	do {								\
+		unsigned long __tmp;					\
+									\
+		asm volatile (						\
+			"adr %2, 1f\n"					\
+			"str %2, %1\n"					\
+			"mov %0, #0\n"					\
+			"b 2f\n"						\
+			"1:\n"						\
+			"mov %0, #1\n"					\
+			"2:"						\
+			: "=&r" (_faulted),				\
+			  "=m" (current->thread.segv_continue),		\
+			  "=&r" (__tmp) ::				\
+		);							\
+	} while (0)
+
+#endif /* __FAULTINFO_ARM_H */
diff --git a/arch/arm/um/shared/sysdep/kernel-offsets.h b/arch/arm/um/shared/sysdep/kernel-offsets.h
new file mode 100644
index 000000000..67cbbfc64
--- /dev/null
+++ b/arch/arm/um/shared/sysdep/kernel-offsets.h
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __SYSDEP_ARM_KERNEL_OFFSETS_H
+#define __SYSDEP_ARM_KERNEL_OFFSETS_H
+
+/*
+ * Subarch contribution to arch/um/kernel/asm-offsets.c.
+ *
+ * arm needs nothing here. Guest TLS is R8, an ordinary regset word the
+ * guest writes itself, so there is no descriptor table geometry the stub
+ * must know.
+ */
+#define ARCH_ASM_OFFSETS() do { } while (0)
+
+#endif
diff --git a/arch/arm/um/shared/sysdep/mcontext.h b/arch/arm/um/shared/sysdep/mcontext.h
new file mode 100644
index 000000000..7e5861f4b
--- /dev/null
+++ b/arch/arm/um/shared/sysdep/mcontext.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __SYS_SIGCONTEXT_ARM_H
+#define __SYS_SIGCONTEXT_ARM_H
+
+/*
+ * On 32-bit arm, glibc's mcontext_t is defined only in <sys/ucontext.h> --
+ * unlike x86_64 and aarch64, where <signal.h> has already pulled it in by
+ * the time this header is parsed. Take it here rather than in every
+ * consumer. Host ABIs that ship an mcontext_t of some other shape are not
+ * supported; the one named type the UML host code knows is the glibc/musl
+ * sigcontext.
+ */
+#include <sys/ucontext.h>
+
+/*
+ * Forward-declare the two struct types the prototypes below take by
+ * pointer. This header is kept freestanding (it is also included from
+ * stub_segv.c, which is compiled with no other UML headers), so it must
+ * not pull in the headers that define these types: struct uml_pt_regs
+ * comes from sysdep/ptrace.h and struct stub_data from the skas
+ * stub-data.h. Without the forward declarations a struct named only
+ * inside a parameter list is a *different* type than the one the
+ * definitions in os-Linux/mcontext.c see after they include those
+ * headers, which is a "conflicting types for 'get_stub_state'" error.
+ */
+struct uml_pt_regs;
+struct stub_data;
+
+extern void get_regs_from_mc(struct uml_pt_regs *regs, mcontext_t *mc);
+extern void get_mc_from_regs(struct uml_pt_regs *regs, mcontext_t *mc,
+			     int single_stepping);
+extern void mc_set_rip(void *_mc, void *target);
+
+extern int get_stub_state(struct uml_pt_regs *regs, struct stub_data *data,
+			  unsigned long *fp_size_out);
+extern int set_stub_state(struct uml_pt_regs *regs, struct stub_data *data,
+			  int single_stepping);
+
+/*
+ * Magic of the VFP record in the ucontext's uc_regspace[] extension area.
+ * Spelled out rather than pulled from the host's <asm/sigcontext.h>
+ * because this header is included by stub_segv.c, which is compiled
+ * freestanding for the stub and must not acquire new dependencies; the
+ * value is a stable uapi constant (VFP_MAGIC in arch/arm's kernel
+ * ucontext.h) and the record shape is spelled out in os-Linux/mcontext.c.
+ */
+#define UM_VFP_MAGIC	0x56465001UL
+
+#endif /* __SYS_SIGCONTEXT_ARM_H */
diff --git a/arch/arm/um/shared/sysdep/ptrace.h b/arch/arm/um/shared/sysdep/ptrace.h
new file mode 100644
index 000000000..2c0b7d4d9
--- /dev/null
+++ b/arch/arm/um/shared/sysdep/ptrace.h
@@ -0,0 +1,124 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __SYSDEP_ARM_PTRACE_H
+#define __SYSDEP_ARM_PTRACE_H
+
+#include <generated/user_constants.h>
+#include <sysdep/faultinfo.h>
+
+/*
+ * gp[] mirrors the 72-byte PTRACE_GETREGS block (the kernel's
+ * struct pt_regs.uregs[18]: r0-r10, fp, ip, sp, lr, pc, cpsr, orig_r0)
+ * followed by one slot UML synthesises itself. Only the first
+ * UM_FRAME_SIZE bytes are ever handed to the host; see user-offsets.c.
+ */
+#define MAX_REG_OFFSET (UM_FRAME_SIZE)
+#define MAX_REG_NR (UM_MAX_REG_NR)
+
+#define REGS_X(r, n)	((r)[(n)])
+#define REGS_SP(r)	((r)[HOST_SP])
+#define REGS_IP(r)	((r)[HOST_PC])
+#define REGS_LR(r)	((r)[HOST_LR])
+#define REGS_CPSR(r)	((r)[HOST_CPSR])
+#define REGS_ORIG_R0(r)	((r)[HOST_ORIG_R0])
+#define REGS_SYSCALL_NR(r) ((r)[HOST_SYSCALL_NR])
+#define REGS_TLS(r)	((r)[HOST_TLS])
+
+#define UPT_X(r, n)	REGS_X((r)->gp, n)
+#define UPT_SP(r)	REGS_SP((r)->gp)
+#define UPT_IP(r)	REGS_IP((r)->gp)
+#define UPT_LR(r)	REGS_LR((r)->gp)
+#define UPT_CPSR(r)	REGS_CPSR((r)->gp)
+#define UPT_ORIG_R0(r)	REGS_ORIG_R0((r)->gp)
+#define UPT_TLS(r)	REGS_TLS((r)->gp)
+
+/*
+ * EABI syscall ABI: arguments in r0..r5, the number in r7, the result in
+ * r0. Unlike arm64, argument 1 and the return value are both r0, and UML
+ * does not capture r0 into a separate original-argument slot: the host
+ * kernel already publishes the original first argument inside the regset
+ * at ureg[17], which is an ordinary member of every stop, so ARG1 reads
+ * r0 directly and is correct -- the -ENOSYS seed hazard is handled below.
+ */
+#define UPT_SYSCALL_ARG1(r) UPT_X(r, HOST_R0)
+#define UPT_SYSCALL_ARG2(r) UPT_X(r, HOST_R1)
+#define UPT_SYSCALL_ARG3(r) UPT_X(r, HOST_R2)
+#define UPT_SYSCALL_ARG4(r) UPT_X(r, HOST_R3)
+#define UPT_SYSCALL_ARG5(r) UPT_X(r, HOST_R4)
+#define UPT_SYSCALL_ARG6(r) UPT_X(r, HOST_R5)
+
+/*
+ * When to seed the return register with -ENOSYS.
+ *
+ * x86 does it unconditionally before the syscall-entry stop, and that is
+ * faithful there: native x86 really does leave -ENOSYS in RAX at an entry
+ * stop, and RAX is not an argument register.
+ *
+ * On arm32 the return value and the first argument are both r0, so seeding
+ * early overwrites the argument -- and a guest tracer reading the classic
+ * register view then sees -38 as argument 1 of every syscall. The arm host
+ * kernel seeds r0 with -ENOSYS in exactly one case: when the incoming
+ * number is already NO_SYSCALL (arch/arm/kernel/ptrace.c), so match that.
+ */
+#define UM_SEED_ENOSYS_BEFORE_TRACE(r)	((long)UPT_SYSCALL_NR(r) < 0)
+
+/*
+ * A syscall is restarted by rewinding over the "svc #0" that issued it.
+ * UGL is compiled in the ARM state, so this is exact: every guest
+ * instruction is 4 bytes wide (the thumb halfword is the guest's own
+ * business; the svc that stopped is always ARM-encoded).
+ *
+ * Three registers have to be put back, and two of them differ from x86:
+ *
+ *   r0  by the time we decide to restart, it holds -ERESTARTSYS rather than
+ *       the first argument. Unlike arm64's x0, the original first argument
+ *       is a real member of the host regset (ureg[17]), so restoring it is
+ *       a plain slot copy.
+ *
+ *   r7  because the guest is about to *re-execute* the svc, and it is r7
+ *       that selects the syscall at that point -- not the synthesised
+ *       UML slot, which only records the number for UML's own bookkeeping.
+ *       Without this, "PT_REGS_ORIG_SYSCALL(regs) = __NR_restart_syscall"
+ *       in arch/um/kernel/signal.c silently has no effect: the guest
+ *       re-runs the original syscall instead of restart_syscall, so a
+ *       signal-interrupted nanosleep restarts its full duration rather
+ *       than its remainder.
+ *
+ * The two call sites in arch/um/kernel/signal.c assign ORIG_SYSCALL before
+ * and after this macro respectively; taking the number from the slot rather
+ * than from a parameter is what makes both orderings come out right.
+ */
+#define UPT_RESTART_SYSCALL(r)						\
+	do {								\
+		long __nr = (long)REGS_SYSCALL_NR((r)->gp);		\
+									\
+		UPT_IP(r) -= 4;						\
+		UPT_X(r, HOST_R0) = UPT_ORIG_R0(r);			\
+		if (__nr >= 0)						\
+			UPT_X(r, HOST_R7) = (unsigned long)__nr;	\
+	} while (0)
+
+extern unsigned long host_fp_size;
+
+struct uml_pt_regs {
+	unsigned long gp[MAX_REG_NR];
+	struct faultinfo faultinfo;
+	long syscall;
+	int is_user;
+
+	/*
+	 * Dynamically sized FP registers. This is the host's VFP state:
+	 * ARM_VFPREGS_SIZE bytes of it, probed at boot (host_fp_size), or
+	 * zero on a host without VFP.
+	 */
+	unsigned long fp[];
+};
+
+#define EMPTY_UML_PT_REGS { }
+
+#define UPT_SYSCALL_NR(r) ((r)->syscall)
+#define UPT_FAULTINFO(r) (&(r)->faultinfo)
+#define UPT_IS_USER(r) ((r)->is_user)
+
+extern int arch_init_registers(int pid);
+
+#endif /* __SYSDEP_ARM_PTRACE_H */
diff --git a/arch/arm/um/shared/sysdep/ptrace_user.h b/arch/arm/um/shared/sysdep/ptrace_user.h
new file mode 100644
index 000000000..2c86be7ba
--- /dev/null
+++ b/arch/arm/um/shared/sysdep/ptrace_user.h
@@ -0,0 +1,68 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __SYSDEP_ARM_PTRACE_USER_H
+#define __SYSDEP_ARM_PTRACE_USER_H
+
+#include <generated/user_constants.h>
+
+#define PT_OFFSET(r) ((r) * sizeof(long))
+
+/*
+ * The synthesised syscall-number slot. Like x86, the host's word-granular
+ * user area does not expose it: it lives one word past the 72-byte regset
+ * block, and UML serves PEEKUSER/POKEUSER there from its own copy. The
+ * original first argument is different -- it is a real regset word at
+ * ureg[17] -- so both directions read from the slot here and only the
+ * number is synthesised.
+ */
+#define PT_SYSCALL_NR(regs) ((regs)[HOST_SYSCALL_NR])
+#define PT_SYSCALL_NR_OFFSET PT_OFFSET(HOST_SYSCALL_NR)
+
+#define PT_SYSCALL_RET_OFFSET PT_OFFSET(HOST_R0)
+
+#define REGS_IP_INDEX HOST_PC
+#define REGS_SP_INDEX HOST_SP
+
+/*
+ * The instruction that enters the kernel, for hosts without PTRACE_SYSEMU.
+ *
+ * arm has had PTRACE_SYSEMU nowhere in its uapi, so the guest syscall is
+ * intercepted on every host by cancelling it at a PTRACE_SYSCALL stop
+ * instead -- exactly the pre-5.3 arm64 situation, which this header copies.
+ * That covers every case but one: while the guest is being single-stepped,
+ * a PTRACE_SINGLESTEP over the entry instruction would execute the guest's
+ * syscall on the host before any stop could cancel it. UML therefore looks
+ * at the instruction it is about to step and takes a syscall stop for that
+ * one. UGL is built in the ARM state (see arch/arm/Makefile.um), so the
+ * svc is always the 32-bit ARM encoding.
+ */
+#define UM_SYSCALL_TRAP_INSN	0xea000000U	/* svc #0 */
+
+/*
+ * No register is hidden at a ptrace syscall stop on arm32. The host kernel
+ * publishes the original first argument inside the regset at ureg[17], and
+ * every other word -- including r7, the live syscall number, which is
+ * readable and writable at the stop -- is ordinary. Writing r7 is not a
+ * hazard but the very mechanism UML uses to redirect the next svc, and
+ * UPT_RESTART_SYSCALL() already puts the number there through the ordinary
+ * slot. x86 and arm64 each define UM_SYSCALL_STOP_HIDES_REG for a register
+ * the host refuses; arm32 defines none, so the generic step-off code in
+ * arch/um/os-Linux/skas/process.c is compiled out here.
+ */
+
+#ifndef PTRACE_SYSEMU
+/* arm takes 31 for PTRACE_GETFDPIC; the unused numbers are free. */
+#define PTRACE_SYSEMU 32
+#endif
+#ifndef PTRACE_SYSEMU_SINGLESTEP
+#define PTRACE_SYSEMU_SINGLESTEP 33
+#endif
+
+/*
+ * NT_ARM_VFP is a stable uapi value, but old host headers predate it, and
+ * the regset path needs it to spell the FP note type.
+ */
+#ifndef NT_ARM_VFP
+#define NT_ARM_VFP 0x400
+#endif
+
+#endif /* __SYSDEP_ARM_PTRACE_USER_H */
diff --git a/arch/arm/um/shared/sysdep/stub-data.h b/arch/arm/um/shared/sysdep/stub-data.h
new file mode 100644
index 000000000..f05d52f17
--- /dev/null
+++ b/arch/arm/um/shared/sysdep/stub-data.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __ARCH_STUB_DATA_H
+#define __ARCH_STUB_DATA_H
+
+/*
+ * Guest TLS on arm is R8, a member of the core regset: the guest writes
+ * it with an ordinary store and the host's sigcontext carries it in every
+ * signal frame. There is no set_thread_area(2) to intercept and no
+ * dedicated TLS register to chase, so the only thing UML has to do is
+ * reinstate the register when it resumes a different guest thread in the
+ * same stub process.
+ */
+#define STUB_SYNC_TLS (1 << 0)
+
+struct stub_data_arch {
+	int sync;
+	unsigned long tls;
+};
+
+#endif /* __ARCH_STUB_DATA_H */
diff --git a/arch/arm/um/shared/sysdep/stub.h b/arch/arm/um/shared/sysdep/stub.h
new file mode 100644
index 000000000..9d32cd21e
--- /dev/null
+++ b/arch/arm/um/shared/sysdep/stub.h
@@ -0,0 +1,359 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __SYSDEP_ARM_STUB_H
+#define __SYSDEP_ARM_STUB_H
+
+#include <stddef.h>
+#include <asm/unistd.h>
+#include <sys/mman.h>
+#include <signal.h>
+#include <as-layout.h>
+#include <stub-data.h>
+#include <sysdep/ptrace_user.h>
+#include <generated/asm-offsets.h>
+
+/*
+ * The stub is position-independent code mapped into every guest address space.
+ * It runs with no libc, no stack guard and no TLS of its own, so every host
+ * syscall it makes has to be raw inline asm.
+ *
+ * arm EABI: r7 = syscall number, r0..r5 = arguments, "svc #0", result in r0.
+ * The kernel preserves r1..r11 across the trap and replaces only r0, so
+ * unlike x86 -- where "syscall" destroys rcx and r11 -- there is nothing to
+ * add to the clobber list beyond memory.
+ */
+
+/*
+ * arm EABI has no __NR_mmap: the EABI table only carries __NR_mmap2
+ * (192), whose offset is in page units. That is the same shape as the
+ * x86 32-bit stub, which also maps through __NR_mmap2 and converts the
+ * byte offset to a page offset with MMAP_OFFSET below.
+ */
+#define STUB_MMAP_NR __NR_mmap2
+/*
+ * arm needs no syscall to restore guest TLS: R8 is an ordinary register the
+ * guest writes itself, so stub_seccomp_restore_state() below is a single
+ * "mov" instruction. -1 keeps the seccomp filter's shape identical across
+ * subarchs without permitting anything, since no syscall number is -1.
+ */
+#define STUB_SECCOMP_TLS_SYSCALL (-1)
+/* __NR_mmap2 takes its offset in page units, like the x86 32-bit stub. */
+#define MMAP_OFFSET(o) ((o) >> UM_KERN_PAGE_SHIFT)
+
+static __always_inline long stub_syscall0(long syscall)
+{
+	register long r7 __asm__("r7") = syscall;
+	register long r0 __asm__("r0");
+
+	__asm__ volatile ("svc #0"
+		: "=r" (r0)
+		: "r" (r7)
+		: "memory");
+
+	return r0;
+}
+
+static __always_inline long stub_syscall1(long syscall, long arg1)
+{
+	register long r7 __asm__("r7") = syscall;
+	register long r0 __asm__("r0") = arg1;
+
+	__asm__ volatile ("svc #0"
+		: "+r" (r0)
+		: "r" (r7)
+		: "memory");
+
+	return r0;
+}
+
+static __always_inline long stub_syscall2(long syscall, long arg1, long arg2)
+{
+	register long r7 __asm__("r7") = syscall;
+	register long r0 __asm__("r0") = arg1;
+	register long r1 __asm__("r1") = arg2;
+
+	__asm__ volatile ("svc #0"
+		: "+r" (r0)
+		: "r" (r7), "r" (r1)
+		: "memory");
+
+	return r0;
+}
+
+static __always_inline long stub_syscall3(long syscall, long arg1, long arg2,
+					  long arg3)
+{
+	register long r7 __asm__("r7") = syscall;
+	register long r0 __asm__("r0") = arg1;
+	register long r1 __asm__("r1") = arg2;
+	register long r2 __asm__("r2") = arg3;
+
+	__asm__ volatile ("svc #0"
+		: "+r" (r0)
+		: "r" (r7), "r" (r1), "r" (r2)
+		: "memory");
+
+	return r0;
+}
+
+static __always_inline long stub_syscall4(long syscall, long arg1, long arg2,
+					  long arg3, long arg4)
+{
+	register long r7 __asm__("r7") = syscall;
+	register long r0 __asm__("r0") = arg1;
+	register long r1 __asm__("r1") = arg2;
+	register long r2 __asm__("r2") = arg3;
+	register long r3 __asm__("r3") = arg4;
+
+	__asm__ volatile ("svc #0"
+		: "+r" (r0)
+		: "r" (r7), "r" (r1), "r" (r2), "r" (r3)
+		: "memory");
+
+	return r0;
+}
+
+static __always_inline long stub_syscall5(long syscall, long arg1, long arg2,
+					  long arg3, long arg4, long arg5)
+{
+	register long r7 __asm__("r7") = syscall;
+	register long r0 __asm__("r0") = arg1;
+	register long r1 __asm__("r1") = arg2;
+	register long r2 __asm__("r2") = arg3;
+	register long r3 __asm__("r3") = arg4;
+	register long r4 __asm__("r4") = arg5;
+
+	__asm__ volatile ("svc #0"
+		: "+r" (r0)
+		: "r" (r7), "r" (r1), "r" (r2), "r" (r3), "r" (r4)
+		: "memory");
+
+	return r0;
+}
+
+static __always_inline long stub_syscall6(long syscall, long arg1, long arg2,
+					  long arg3, long arg4, long arg5,
+					  long arg6)
+{
+	register long r7 __asm__("r7") = syscall;
+	register long r0 __asm__("r0") = arg1;
+	register long r1 __asm__("r1") = arg2;
+	register long r2 __asm__("r2") = arg3;
+	register long r3 __asm__("r3") = arg4;
+	register long r4 __asm__("r4") = arg5;
+	register long r5 __asm__("r5") = arg6;
+
+	__asm__ volatile ("svc #0"
+		: "+r" (r0)
+		: "r" (r7), "r" (r1), "r" (r2), "r" (r3), "r" (r4), "r" (r5)
+		: "memory");
+
+	return r0;
+}
+
+/*
+ * Deliberate SIGTRAP, so the UML kernel can catch the stub at a known point.
+ *
+ * "swi #1" with r7 = __ARM_NR_breakpoint is the arm kernel's special-syscall
+ * breakpoint: the swi routes through the same syscall path, arm_syscall()
+ * recognises the number, backsteps the PC over the instruction and raises
+ * SIGTRAP/TRAP_BRKPT. A plain "svc #0" with a bogus number would instead be
+ * -ENOSYS, and a hardware bkpt instruction would give SIGILL.
+ */
+#ifndef __ARM_NR_breakpoint
+#define __ARM_NR_breakpoint 0x900001
+#endif
+
+static __always_inline void trap_myself(void)
+{
+	register long r7 __asm__("r7") = (long)__ARM_NR_breakpoint;
+
+	__asm__ volatile ("swi #1"
+		:
+		: "r" (r7)
+		: "memory");
+}
+
+/*
+ * Handoff-word atomics for <stub-futex.h>.
+ *
+ * These carry the ordering the elided futex syscalls used to provide. On
+ * this architecture that is a real obligation, not a formality: without the
+ * acquire on the load, a spinner that observes the ownership flip may still
+ * read stale syscall_data or signal fields. Hence the "dmb ish" after the
+ * load, and the LDEX/STEX pairs for the read-modify-writes, which give
+ * acquire+release semantics by construction.
+ */
+static __always_inline unsigned int
+stub_futex_load_acquire(volatile unsigned int *addr)
+{
+	unsigned int val;
+
+	__asm__ volatile("ldr	%0, [%1]\n"
+			"dmb	ish"
+		: "=r" (val)
+		: "r" (addr)
+		: "memory");
+
+	return val;
+}
+
+static __always_inline unsigned int
+stub_futex_xchg(volatile unsigned int *addr, unsigned int val)
+{
+	unsigned int old, fail;
+
+	__asm__ volatile(
+		"1:	ldrex	%0, [%2]\n"
+		"	strex	%1, %3, [%2]\n"
+		"	cbnz	%1, 1b\n"
+		: "=&r" (old), "=&r" (fail)
+		: "r" (addr), "r" (val)
+		: "cc", "memory");
+
+	return old;
+}
+
+static __always_inline unsigned int
+stub_futex_fetch_or(volatile unsigned int *addr, unsigned int bits)
+{
+	unsigned int old, newval, fail;
+
+	__asm__ volatile(
+		"1:	ldrex	%0, [%3]\n"
+		"	orr	%1, %0, %4\n"
+		"	strex	%2, %1, [%3]\n"
+		"	cbnz	%2, 1b\n"
+		: "=&r" (old), "=&r" (newval), "=&r" (fail)
+		: "r" (addr), "r" (bits)
+		: "cc", "memory");
+
+	return old;
+}
+
+/* Be polite to a shared or virtualized host; on bare cores it is a hint. */
+static __always_inline void stub_relax(void)
+{
+	__asm__ volatile("yield");
+}
+
+/*
+ * The generic timer's virtual counter: constant-rate, synchronized across
+ * cores, and readable from user space on every Linux arm host because the
+ * vDSO clock needs it too (CNTKCTL.EL0VCTEN). The CPU clock is none of
+ * those things -- it scales under the governor, which is exactly why the
+ * spin bound is expressed in these ticks.
+ *
+ * No "isb" before the read: the barrier would cost more than the few cycles
+ * of speculation slack it removes, and a microsecond-scale budget does not
+ * care.
+ */
+static __always_inline unsigned long stub_cycles(void)
+{
+	unsigned long val;
+
+	__asm__ volatile("mrc p15, 0, %0, c0, c0, 0" : "=r" (val));
+
+	return val;
+}
+
+/*
+ * CNTFRQ is readable wherever CNTVCT is. Firmware that leaves it
+ * unprogrammed reads as 0, which flows through the budget arithmetic as
+ * "never spin" -- a safe degradation, not a crash.
+ */
+static __always_inline unsigned long stub_cycles_per_us(void)
+{
+	unsigned long freq;
+
+	__asm__ volatile("mrc p15, 0, %0, c2, c0, 0" : "=r" (freq));
+
+	return freq / 1000000;
+}
+
+/*
+ * The stub's data page immediately follows its code page. "adr" gives a
+ * PC-relative address in a single instruction, so this is one instruction
+ * cheaper than x86's "lea 0(%rip)".
+ *
+ * The mask is a register operand, not an immediate: UM_KERN_PAGE_SIZE is
+ * not a compile-time constant this code may assume, and the mask has to
+ * come from the generated offsets.
+ */
+static __always_inline void *get_stub_data(void)
+{
+	unsigned long ret;
+
+	__asm__ volatile (
+		"adr %0, .\n"
+		"and %0, %0, %1\n"
+		"add %0, %0, %2\n"
+		: "=&r" (ret)
+		: "r" (~(unsigned long)(UM_KERN_PAGE_SIZE - 1)),
+		  "r" ((unsigned long)UM_KERN_PAGE_SIZE)
+		: "cc");
+
+	return (void *)ret;
+}
+
+/*
+ * Drop the stack below the stub mapping and call fn. STUB_SIZE is passed in a
+ * register rather than as an immediate for the same reason as above. The
+ * call is a "blx" to a register (the kernel's own register-call spelling,
+ * see arch/arm/probes/kprobes): UGL is -marm, so the target's low bit is
+ * clear and the branch lands in ARM state.
+ */
+#define stub_start(fn)							\
+	__asm__ volatile (						\
+		"sub sp, sp, %0\n"					\
+		"blx %1\n"						\
+		:: "r" ((unsigned long)STUB_SIZE),			\
+		   "r" (&fn)						\
+		: "lr", "memory")
+
+/*
+ * Report the guest's current TLS back to the kernel.
+ *
+ * R8 is guest-owned: the guest's compiler writes it with an ordinary
+ * "mov r8, ..." (that is what the EABI local-exec TLS model is), and no
+ * host syscall ever sees the write. So when the stub resumes a different
+ * guest thread, whatever R8 the host is currently holding is stale, and
+ * the real value must come from the thread's saved registers.
+ */
+static __always_inline void
+stub_seccomp_save_state(struct stub_data_arch *arch)
+{
+	__asm__ volatile ("mov %0, r8" : "=r" (arch->tls));
+}
+
+/*
+ * Reinstate guest TLS after the stub is resumed for a different guest
+ * thread. R8 is writable from user space, so this costs a single
+ * instruction and no host syscall at all.
+ */
+static __always_inline void
+stub_seccomp_restore_state(struct stub_data_arch *arch)
+{
+	if (arch->sync & STUB_SYNC_TLS)
+		__asm__ volatile ("mov r8, %0" :: "r" (arch->tls) : "cc");
+
+	arch->sync = 0;
+}
+
+/*
+ * stub_arch_init() - what this architecture must do inside a fresh stub
+ *
+ * Nothing. arm has no per-stub architectural state to reset: no pointer
+ * authentication, no TBI keys, no MTE state. The guest's VFP/NEON state is
+ * the guest's own to keep, and a fresh stub simply arrives with whatever
+ * the host exec produced, which for the FPU is the default-off state.
+ */
+static __always_inline void stub_arch_init(void)
+{
+}
+
+extern void stub_segv_handler(int, siginfo_t *, void *);
+extern void stub_syscall_handler(void);
+extern void stub_signal_interrupt(int, siginfo_t *, void *);
+extern void stub_signal_restorer(void);
+
+#endif /* __SYSDEP_ARM_STUB_H */
diff --git a/arch/arm/um/shared/sysdep/tls.h b/arch/arm/um/shared/sysdep/tls.h
new file mode 100644
index 000000000..20d2923f6
--- /dev/null
+++ b/arch/arm/um/shared/sysdep/tls.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _SYSDEP_TLS_H
+#define _SYSDEP_TLS_H
+
+/*
+ * arm has no segment descriptors and no set_thread_area(2): thread-local
+ * storage is just R8, which the guest writes like any other register. This
+ * header exists only because arch/um/include/shared/skas/stub-data.h
+ * includes <sysdep/tls.h> unconditionally, and because x86 needs a
+ * user_desc-shaped type there.
+ *
+ * user_desc_t is defined as a one-word placeholder rather than omitted so
+ * that generic code which merely mentions the type still compiles; nothing
+ * on arm ever populates one.
+ */
+
+typedef struct um_arm_tls_desc {
+	unsigned long tp_value;		/* R8 */
+} user_desc_t;
+
+#endif /* _SYSDEP_TLS_H */
diff --git a/arch/arm/um/signal.c b/arch/arm/um/signal.c
new file mode 100644
index 000000000..11a6ec36a
--- /dev/null
+++ b/arch/arm/um/signal.c
@@ -0,0 +1,401 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Guest signal delivery for ARCH=um SUBARCH=arm.
+ *
+ * The frame built here is consumed by guest userspace, so it must match the
+ * arm32 signal ABI exactly -- glibc, musl and bionic all parse it. It is
+ * laid out the same way arch/arm/kernel/signal.c lays it out:
+ *
+ *	 sp ->	struct rt_sigframe { siginfo info; struct sigframe sig; }
+ *		struct sigframe { struct ucontext uc; unsigned long retcode[4]; }
+ *
+ * and on entry to the handler:
+ *
+ *	r0 = signo, r1 = &info, r2 = &sig.uc
+ *	sp = frame, lr = restorer, pc = handler
+ *
+ * uc.uc_regspace carries a chain of coprocessor records, each headed by a
+ * 32-bit magic and size. UML writes a vfp_sigframe when the host's VFP state
+ * is reachable (host_fp_size, set by the PTRACE_GETVFPREGS probe in
+ * arch_init_registers()), and a zero terminator otherwise. It deliberately
+ * does not write an iwmmxt record: no iwmmxt host state exists to copy, and
+ * emitting one whose storage came from nowhere would tell guest userspace it
+ * may use state the guest kernel never saves.
+ *
+ * Unlike x86-32, the 32-bit arm ABI hands the handler its return address in
+ * the *link* register, and the return address is a restorer trampoline that
+ * issues the sigreturn syscall on the guest's behalf. The real kernel writes
+ * the two-instruction trampoline into the frame's retcode[] slot (or an
+ * executable sigpage), which is out of the question here: UGL does not give
+ * the guest stack executable pages. Every mainstream arm32 libc sets
+ * SA_RESTORER with its own trampoline, which is used when present; the
+ * fallback is a plain function of the UML binary itself, because that
+ * binary *is* the guest's executable text.
+ */
+#include <linux/kernel.h>
+#include <linux/signal.h>
+#include <linux/syscalls.h>
+#include <linux/uaccess.h>
+#include <asm/unistd.h>
+#include <asm/ucontext.h>
+#include <asm/sigcontext.h>
+#include <frame_kern.h>
+#include <registers.h>
+#include <skas.h>
+
+/* Defined in os-Linux/registers.c, probed at boot; zero when the host
+ * kernel has no VFP state to hand over. */
+extern unsigned long host_fp_size;
+
+struct sigframe {
+	struct ucontext uc;
+	unsigned long retcode[4];
+};
+
+struct rt_sigframe {
+	struct siginfo info;
+	struct sigframe sig;
+};
+
+/*
+ * The bytes moved between the host's fp payload (regs->fp, sized at boot by
+ * host_fp_size) and the ufp member of a vfp_sigframe: 32 x 8 bytes of
+ * fpregs plus the 4-byte fpscr, in both orders. Not sizeof(uvp), which
+ * carries 4 padding bytes neither the host nor a valid record ever fills.
+ */
+#define UM_VFP_PAYLOAD_SIZE (32 * 8 + 4)
+
+/*
+ * Where the handler returns to when the guest did not supply SA_RESTORER.
+ * Plain ARM state, not thumb: the UML binary is built -march=armv7-a with no
+ * thumb mix, and this function is executed in whatever state the handler
+ * leaves, which is ARM.
+ *
+ * Only the rt form exists: setup_signal_stack_sc forwards to the rt layout,
+ * so the restorer that every UGL-built frame installs is the rt one.
+ */
+static noinline void um_rt_sigreturn_restorer(void)
+{
+	__asm__ __volatile__(
+		"mov\tr7, %0\n"
+		"svc\t#0\n"
+		: : "i"(__NR_rt_sigreturn));
+}
+
+#ifdef CONFIG_VFP
+static void vfp_to_sigctx(struct vfp_sigframe *vfp, struct pt_regs *regs)
+{
+	if (!host_fp_size)
+		return;
+
+	vfp->magic = VFP_MAGIC;
+	vfp->size = VFP_STORAGE_SIZE;
+	memset(&vfp->ufp_exc, 0, sizeof(vfp->ufp_exc));
+	memcpy(&vfp->ufp, regs->regs.fp, host_fp_size);
+}
+#endif
+
+/*
+ * Walk uc_regspace for the VFP record. DUMMY and IWMMXT blocks are skipped
+ * using their documented sizes, as the real kernel's restore_*_context()
+ * does; a malformed record simply ends the walk, and the guest keeps the fp
+ * state it had, which is what the hardware does when the record is absent.
+ * The walk is bounded by the record sizes and the buffer length, so a
+ * corrupted sigframe cannot read past it.
+ */
+static void sigctx_to_vfp(struct pt_regs *regs, const unsigned long *regspace)
+{
+#ifdef CONFIG_VFP
+	const unsigned long *p = regspace;
+	unsigned long left = sizeof(uc.uc_regspace);
+
+	while (left >= sizeof(vfp_sigframe)) {
+		unsigned long magic = p[0];
+		unsigned long size = p[1];
+
+		if (!magic || !size || size > left || (size & 7))
+			break;
+
+		if (magic == VFP_MAGIC && size >= sizeof(vfp_sigframe)) {
+			struct vfp_sigframe vfp;
+
+			memcpy(&vfp, p, sizeof(vfp));
+			if (host_fp_size >= UM_VFP_PAYLOAD_SIZE)
+				memcpy(regs->regs.fp, &vfp.ufp, host_fp_size);
+			break;
+		}
+
+		/*
+		 * DUMMY blocks are padding, IWMMXT blocks the iWMMXt state;
+		 * both are skipped over with their recorded size. UML never
+		 * writes an IWMMXT record, so on a build without
+		 * CONFIG_IWMMXT only the DUMMY case remains.
+		 */
+		if (magic == DUMMY_MAGIC
+#ifdef CONFIG_IWMMXT
+		    || magic == IWMMXT_MAGIC
+#endif
+		) {
+			p += size / sizeof(unsigned long);
+			left -= size;
+			continue;
+		}
+
+		break;
+	}
+#endif
+}
+
+static int copy_sc_from_user(struct pt_regs *regs,
+			     struct ucontext __user *from)
+{
+	struct ucontext uc;
+
+	/* Any restarted syscall interrupted by this signal now returns -EINTR. */
+	current->restart_block.fn = do_no_restart_syscall;
+
+	if (copy_from_user(&uc, from, sizeof(uc)))
+		return 1;
+
+	regs->regs.gp[HOST_R0] = uc.uc_mcontext.arm_r0;
+	regs->regs.gp[HOST_R1] = uc.uc_mcontext.arm_r1;
+	regs->regs.gp[HOST_R2] = uc.uc_mcontext.arm_r2;
+	regs->regs.gp[HOST_R3] = uc.uc_mcontext.arm_r3;
+	regs->regs.gp[HOST_R4] = uc.uc_mcontext.arm_r4;
+	regs->regs.gp[HOST_R5] = uc.uc_mcontext.arm_r5;
+	regs->regs.gp[HOST_R6] = uc.uc_mcontext.arm_r6;
+	regs->regs.gp[HOST_R7] = uc.uc_mcontext.arm_r7;
+	regs->regs.gp[HOST_R8] = uc.uc_mcontext.arm_r8;
+	regs->regs.gp[HOST_R9] = uc.uc_mcontext.arm_r9;
+	regs->regs.gp[HOST_R10] = uc.uc_mcontext.arm_r10;
+	regs->regs.gp[HOST_FP] = uc.uc_mcontext.arm_fp;
+	regs->regs.gp[HOST_IP] = uc.uc_mcontext.arm_ip;
+	regs->regs.gp[HOST_SP] = uc.uc_mcontext.arm_sp;
+	regs->regs.gp[HOST_LR] = uc.uc_mcontext.arm_lr;
+	regs->regs.gp[HOST_PC] = uc.uc_mcontext.arm_pc;
+
+	/*
+	 * CPSR is filtered the same way arch/arm/kernel/ptrace.c filters it
+	 * for a debugger (valid_user_regs): only the F, S, X and T bits plus
+	 * the 32-bit mode bit are writable. Restoring the field verbatim from
+	 * a user-writable buffer would let the guest hand itself kernel mode
+	 * or 26-bit state.
+	 */
+	regs->regs.gp[HOST_CPSR] =
+		(regs->regs.gp[HOST_CPSR] & ~UM_CPSR_WRITABLE) |
+		(uc.uc_mcontext.arm_cpsr & UM_CPSR_WRITABLE);
+
+	/* Synthetic slot, kept honest for the syscall restart machinery. */
+	regs->regs.gp[HOST_SYSCALL_NR] = uc.uc_mcontext.arm_r7;
+
+	sigctx_to_vfp(regs, uc.uc_regspace);
+
+	return 0;
+}
+
+static int copy_sc_to_user(struct ucontext __user *to, struct pt_regs *regs,
+			   sigset_t *mask)
+{
+	struct ucontext uc;
+
+	memset(&uc, 0, sizeof(uc));
+
+	uc.uc_mcontext.arm_r0 = regs->regs.gp[HOST_R0];
+	uc.uc_mcontext.arm_r1 = regs->regs.gp[HOST_R1];
+	uc.uc_mcontext.arm_r2 = regs->regs.gp[HOST_R2];
+	uc.uc_mcontext.arm_r3 = regs->regs.gp[HOST_R3];
+	uc.uc_mcontext.arm_r4 = regs->regs.gp[HOST_R4];
+	uc.uc_mcontext.arm_r5 = regs->regs.gp[HOST_R5];
+	uc.uc_mcontext.arm_r6 = regs->regs.gp[HOST_R6];
+	uc.uc_mcontext.arm_r7 = regs->regs.gp[HOST_R7];
+	uc.uc_mcontext.arm_r8 = regs->regs.gp[HOST_R8];
+	uc.uc_mcontext.arm_r9 = regs->regs.gp[HOST_R9];
+	uc.uc_mcontext.arm_r10 = regs->regs.gp[HOST_R10];
+	uc.uc_mcontext.arm_fp = regs->regs.gp[HOST_FP];
+	uc.uc_mcontext.arm_ip = regs->regs.gp[HOST_IP];
+	uc.uc_mcontext.arm_sp = regs->regs.gp[HOST_SP];
+	uc.uc_mcontext.arm_lr = regs->regs.gp[HOST_LR];
+	uc.uc_mcontext.arm_pc = regs->regs.gp[HOST_PC];
+	uc.uc_mcontext.arm_cpsr = regs->regs.gp[HOST_CPSR];
+
+	/*
+	 * error_code carries the FSR of the fault that started this frame,
+	 * from the stub's faultinfo; oldmask is the first word of the old
+	 * mask, as the real kernel writes it. The arm sigcontext has no
+	 * fault-address member at all -- real arm32 hardware does not
+	 * deliver one either; the guest's handler gets the address from
+	 * siginfo's si_addr, which copy_siginfo_to_user() has already
+	 * placed in the frame.
+	 */
+	uc.uc_mcontext.error_code = current->thread.arch.faultinfo.ec;
+	uc.uc_mcontext.oldmask = mask->sig[0];
+
+#ifdef CONFIG_VFP
+	/*
+	 * The coprocessor chain runs out of the head of uc_regspace, so the
+	 * VFP record must fit in it. With host FP state, vfp_to_sigctx()
+	 * writes one self-delimiting record there; without, the region stays
+	 * zeroed from the memset above, which is already the "no records"
+	 * terminator a parser looks for. Nothing may be zeroed afterwards:
+	 * the record's magic and size fields sit exactly at [0] and [1].
+	 */
+	BUILD_BUG_ON(sizeof(struct vfp_sigframe) > sizeof(uc.uc_regspace));
+
+	vfp_to_sigctx((struct vfp_sigframe *)uc.uc_regspace, regs);
+#endif
+
+	uc.uc_sigmask = *mask;
+
+	return copy_to_user(to, &uc, sizeof(uc));
+}
+
+int setup_signal_stack_si(unsigned long stack_top, struct ksignal *ksig,
+			  struct pt_regs *regs, sigset_t *mask)
+{
+	struct rt_sigframe __user *frame;
+	unsigned long sp;
+	int err = 0;
+
+	/* AAPCS arm32 requires an 8-byte aligned stack pointer at all times. */
+	sp = round_down(stack_top, 8);
+	sp = round_down(sp - sizeof(*frame), 8);
+	frame = (struct rt_sigframe __user *)sp;
+
+	if (!access_ok(frame, sizeof(*frame)))
+		return 1;
+
+	err |= copy_siginfo_to_user(&frame->info, &ksig->info);
+
+	err |= __put_user(0, &frame->sig.uc.uc_flags);
+	err |= __put_user(NULL, &frame->sig.uc.uc_link);
+	err |= __save_altstack(&frame->sig.uc.uc_stack, PT_REGS_SP(regs));
+	err |= copy_sc_to_user(&frame->sig.uc, regs, mask);
+
+	/*
+	 * The retcode[] slot holds the real kernel's in-frame restorer. UGL
+	 * never writes guest stack as executable, so the slot stays zero and
+	 * the return address comes from below instead.
+	 */
+
+	if (err)
+		return err;
+
+	PT_REGS_SP(regs) = (unsigned long) frame;
+	PT_REGS_IP(regs) = (unsigned long) ksig->ka.sa.sa_handler;
+	PT_REGS_R0(regs) = ksig->sig;
+	PT_REGS_R1(regs) = (unsigned long) &frame->info;
+	PT_REGS_R2(regs) = (unsigned long) &frame->sig.uc;
+
+	/*
+	 * Where the handler returns to.
+	 *
+	 * arm32 hands it to the guest through lr. glibc, musl and bionic
+	 * all install a restorer of their own (SA_RESTORER); anything that
+	 * does not gets UGL's, which is executable text of the UML binary
+	 * and therefore present in every stub's address space.
+	 */
+	if (ksig->ka.sa.sa_flags & SA_RESTORER)
+		PT_REGS_LR(regs) = (unsigned long) ksig->ka.sa.sa_restorer;
+	else
+		PT_REGS_LR(regs) = (unsigned long) um_rt_sigreturn_restorer;
+
+	return 0;
+}
+
+/*
+ * arm32 still has a non-realtime frame, but every mainstream libc delivers
+ * through rt_sigaction, and a non-SA_SIGINFO handler that expected a plain
+ * sigframe is a 1990s binary. Forward to the rt layout, as arch/um/kernel/
+ * signal.c's sc variant is only ever called when !SA_SIGINFO.
+ */
+int setup_signal_stack_sc(unsigned long stack_top, struct ksignal *ksig,
+			  struct pt_regs *regs, sigset_t *mask)
+{
+	return setup_signal_stack_si(stack_top, ksig, regs, mask);
+}
+
+/*
+ * The EABI table (arch/arm/tools/syscall.tbl) names its entry points
+ * sys_sigreturn_wrapper and sys_rt_sigreturn_wrapper; the real kernel
+ * implements them in entry-common.S, which is not built for ARCH=um, so
+ * they are repeated here. They take no arguments -- the frame is on the
+ * stack -- but every entry in the UML table has the six-argument shape,
+ * so the wrappers simply ignore what is in r0-r5.
+ */
+asmlinkage long sys_sigreturn_wrapper(unsigned long, unsigned long,
+				      unsigned long, unsigned long,
+				      unsigned long, unsigned long)
+{
+	unsigned long sp = PT_REGS_SP(&current->thread.regs);
+	struct sigframe __user *frame = (struct sigframe __user *)sp;
+	sigset_t set;
+
+	/*
+	 * The frame was placed at an 8-byte boundary, so a misaligned sp
+	 * means the guest corrupted its stack rather than returning from
+	 * a signal.
+	 */
+	if (sp & 7)
+		goto segfault;
+
+	if (copy_from_user(&set, &frame->uc.uc_sigmask, sizeof(set)))
+		goto segfault;
+
+	set_current_blocked(&set);
+
+	if (copy_sc_from_user(&current->thread.regs, &frame->uc))
+		goto segfault;
+
+	/*
+	 * Do not let the syscall restart machinery act on this return value.
+	 *
+	 * It is PT_REGS_SYSCALL_NR that has to be cleared, not
+	 * PT_REGS_ORIG_SYSCALL: arch/um/kernel/signal.c tests
+	 * "PT_REGS_SYSCALL_NR(regs) >= 0" to decide whether a syscall is in
+	 * flight, and on arm32 that maps to the synthetic register slot
+	 * which sigreturn never restores.
+	 *
+	 * The consequence of skipping this is silent: a handler returning
+	 * into a context whose r0 happens to hold one of the four
+	 * -ERESTART* values, with another signal deliverable, gets its
+	 * context rewritten -- the program counter rewound four bytes and
+	 * r0 replaced from a slot sigreturn never restored.
+	 */
+	PT_REGS_SYSCALL_NR(&current->thread.regs) = -1;
+	return PT_REGS_SYSCALL_RET(&current->thread.regs);
+
+ segfault:
+	force_sig(SIGSEGV);
+	return 0;
+}
+
+asmlinkage long sys_rt_sigreturn_wrapper(unsigned long, unsigned long,
+					  unsigned long, unsigned long,
+					  unsigned long, unsigned long)
+{
+	unsigned long sp = PT_REGS_SP(&current->thread.regs);
+	struct rt_sigframe __user *frame = (struct rt_sigframe __user *)sp;
+	struct ucontext __user *uc = &frame->sig.uc;
+	sigset_t set;
+
+	if (sp & 7)
+		goto segfault;
+
+	if (copy_from_user(&set, &uc->uc_sigmask, sizeof(set)))
+		goto segfault;
+
+	set_current_blocked(&set);
+
+	if (copy_sc_from_user(&current->thread.regs, uc))
+		goto segfault;
+
+	if (restore_altstack(&uc->uc_stack))
+		goto segfault;
+
+	PT_REGS_SYSCALL_NR(&current->thread.regs) = -1;
+	return PT_REGS_SYSCALL_RET(&current->thread.regs);
+
+ segfault:
+	force_sig(SIGSEGV);
+	return 0;
+}
diff --git a/arch/arm/um/stub_segv.c b/arch/arm/um/stub_segv.c
