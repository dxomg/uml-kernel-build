diff --git a/arch/arm/um/asm/unistd-nr.h b/arch/arm/um/asm/unistd-nr.h
new file mode 100644
index 000000000..1a298d2de
--- /dev/null
+++ b/arch/arm/um/asm/unistd-nr.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Committed UML copy of arch/arm/include/generated/asm/unistd-nr.h.
+ *
+ * It is generated by arch/arm/tools/syscallnr.sh from arch/arm/tools/syscall.tbl
+ * and committed here because the UML flow never runs arch/arm's archprepare
+ * kapi step (arch/um overrides it to build user_constants.h only), and UML
+ * cannot modify the parent's arch/arm/include/asm/Kbuild to plug one in.
+ *
+ * Regenerate with:
+ * 	sh arch/arm/tools/syscallnr.sh arch/arm/tools/syscall.tbl unistd-nr.h
+ * whenever the parent's syscall table changes.
+ */
+#ifndef _ASM_ARM_UNISTD_NR_H
+#define _ASM_ARM_UNISTD_NR_H 1
+
+/*
+ * This needs to be greater than __NR_last_syscall+1 in order to account
+ * for the padding in the syscall table.
+ */
+
+/* aligned to 4 */
+#define __NR_syscalls 472
+
+#endif /* _ASM_ARM_UNISTD_NR_H */
diff --git a/arch/arm/um/asm/vm-flags.h b/arch/arm/um/asm/vm-flags.h
new file mode 100644
index 000000000..c0056a9fe
--- /dev/null
+++ b/arch/arm/um/asm/vm-flags.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __VM_FLAGS_ARM_H
+#define __VM_FLAGS_ARM_H
+
+/*
+ * The parent arch/arm has no asm/vm-flags.h, so without this the generic
+ * default at include/linux/mm.h stands: VMA_DATA_DEFAULT_FLAGS is
+ * VMA_DATA_FLAGS_EXEC -- data mappings are unconditionally executable.
+ *
+ * Every UML subarch overrides it to VMA_DATA_FLAGS_TSK_EXEC (the x86 and
+ * arm64 UGL ports both do): an executable mapping then comes from the
+ * task's personality rather than from the data flag itself, which matches
+ * what the guest's own mprotect() and personality calls promise. Leaving
+ * the generic default would hand every data mapping -- every guest stack in
+ * particular -- an executable bit that no UML subarch deliberately grants.
+ */
+#define VMA_DATA_DEFAULT_FLAGS	VMA_DATA_FLAGS_TSK_EXEC
+
+#endif /* __VM_FLAGS_ARM_H */
diff --git a/arch/arm/um/bionic-syms.redef b/arch/arm/um/bionic-syms.redef
new file mode 100644
index 000000000..358e588d7 100644
--- /dev/null
+++ b/arch/arm/um/bionic-syms.redef
@@ -0,0 +1,98 @@
+# Kernel symbols renamed when linking against bionic.
+#
+# These are names the kernel defines and bionic's libc also references. In a
+# static link the linker is happy to satisfy libc's reference with the kernel's
+# definition, and the result is libc calling into the kernel: sched_getaffinity
+# was the one that showed the shape of the problem, with bionic's start-up
+# reaching the kernel's implementation and dereferencing a task_struct that does
+# not exist yet. Nothing warns -- libc only references these, so there is no
+# duplicate-definition error to notice.
+#
+# Renaming happens on the object files rather than with -D. The preprocessor
+# does not know the difference between a function name and a token being pasted
+# into an identifier: -Dsnprintf=kernel_snprintf also rewrites the bare
+# "snprintf" inside __BPF_FUNC_MAPPER, so kernel/bpf/disasm.c ends up asking for
+# BPF_FUNC_kernel_snprintf and CONFIG_BPF_SYSCALL will not build. objcopy
+# renames definitions and references together and cannot make that mistake.
+#
+# This file is no longer the whole answer. scripts/link-vmlinux.sh computes the
+# same intersection against the libc actually being linked and adds whatever it
+# finds that is not already here, because the set depends on the libc and not on
+# this tree: NDK r27c's bionic has no sched_setattr, newer ones do, and a list
+# fixed at the version I happened to build with shipped
+#
+#	ld.lld: error: duplicate symbol: sched_setattr
+#	ld.lld: error: duplicate symbol: sync_file_range
+#
+# to anyone using a different NDK. What remains here is the explanation, and the
+# fallback for a build where nm or libc.a cannot be found.
+#
+# Derived, not guessed:
+#   llvm-nm --undefined-only libc.a                > A
+#   llvm-nm --defined-only --extern-only vmlinux.a > B
+#   comm -12 A B
+#
+# and the same again with --defined-only on both sides, which is the set that
+# fails loudly as a duplicate symbol rather than quietly as a bad binding.
+snprintf kernel_snprintf
+vsnprintf kernel_vsnprintf
+sprintf kernel_sprintf
+vsprintf kernel_vsprintf
+sscanf kernel_sscanf
+vsscanf kernel_vsscanf
+stpcpy kernel_stpcpy
+getrusage kernel_getrusage
+sem_init kernel_sem_init
+timer_delete kernel_timer_delete
+sched_setaffinity kernel_sched_setaffinity
+sched_getaffinity kernel_sched_getaffinity
+sched_setscheduler kernel_sched_setscheduler
+abort kernel_abort
+strcasecmp kernel_strcasecmp
+strncasecmp kernel_strncasecmp
+strcspn kernel_strcspn
+strlcat kernel_strlcat
+strpbrk kernel_strpbrk
+strsep kernel_strsep
+strstr kernel_strstr
+
+# Defined by both sides, so these are the ones that stop the link outright.
+# A rename for a name the kernel does not define is a no-op, so listing one
+# that a given config leaves out costs nothing.
+bsearch kernel_bsearch
+strcat kernel_strcat
+strncat kernel_strncat
+strspn kernel_strspn
+sync_file_range kernel_sync_file_range
+sched_setattr kernel_sched_setattr
+sched_getattr kernel_sched_getattr
+
+# The div/mod/shift/multiply helpers arch/arm/um/arm-klib.S links into the
+# host binary from arch/arm/lib. bionic's C runtime carries the AEABI and
+# multi-precision helpers too, so wherever one of the coarser bionic objects
+# we are forced to pull in also defines one of these, the static link fails
+# with a duplicate symbol. The single-underscore bitops names have no bionic
+# counterpart and need no entry; __do_div64 is a kernel name, not a generic
+# compiler helper, so its entry is defensive -- a rename of a symbol bionic
+# does not carry is a no-op, per the note above.
+__divsi3 kernel__divsi3
+__udivsi3 kernel__udivsi3
+__modsi3 kernel__modsi3
+__umodsi3 kernel__umodsi3
+__aeabi_idiv kernel__aeabi_idiv
+__aeabi_uidiv kernel__aeabi_uidiv
+__aeabi_idivmod kernel__aeabi_idivmod
+__aeabi_uidivmod kernel__aeabi_uidivmod
+__muldi3 kernel__muldi3
+__aeabi_lmul kernel__aeabi_lmul
+__ashldi3 kernel__ashldi3
+__aeabi_llsl kernel__aeabi_llsl
+__ashrdi3 kernel__ashrdi3
+__aeabi_lasr kernel__aeabi_lasr
+__lshrdi3 kernel__lshrdi3
+__aeabi_llsr kernel__aeabi_llsr
+__ucmpdi2 kernel__ucmpdi2
+__aeabi_ulcmp kernel__aeabi_ulcmp
+__bswapsi2 kernel__bswapsi2
+__bswapdi2 kernel__bswapdi2
+__do_div64 kernel__do_div64
diff --git a/arch/arm/um/bugs.c b/arch/arm/um/bugs.c
new file mode 100644
index 000000000..22afa1d81
--- /dev/null
+++ b/arch/arm/um/bugs.c
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Host-side sanity checks for ARCH=um SUBARCH=arm.
+ */
+#include <arch.h>
+#include <sysdep/ptrace.h>
+
+void arch_check_bugs(void)
+{
+	/*
+	 * Nothing to check. x86 historically probed for a broken SEP/sysenter
+	 * host; arm has a single svc #0 path and no equivalent to detect.
+	 * The absence of PTRACE_SYSEMU on arm hosts is handled, not a bug:
+	 * start_up.c falls back to PTRACE_SYSCALL with syscall cancellation
+	 * via r7, which is what an arm32 host actually offers.
+	 */
+}
+
+void arch_examine_signal(int sig, struct uml_pt_regs *regs)
+{
+	/*
+	 * x86 uses this to recognise a SIGTRAP that is really a hardware
+	 * breakpoint. UML/arm does not implement hardware breakpoints or
+	 * watchpoints for the guest, so every signal reaching here is what it
+	 * appears to be.
+	 */
+}
+
+/*
+ * __div0, the divide-by-zero handler the arch/arm/lib helpers (the
+ * __aeabi_idiv / __do_div64 families arm-klib.S links in) branch to on a
+ * zero divisor, is deliberately NOT here: it runs in guest-kernel context,
+ * and BUG() would drag <linux/bug.h>'s chain into a USER_OBJ, where every
+ * <linux/*.h> the cross sysroot's linux-libc-dev also ships (types.h and
+ * friends) resolves to the libc copy, which lacks the kernel-internal
+ * bool/atomic_t that chain uses. It lives in arm_ksyms.c, which is built
+ * kernel-side, next to the klib exports it backs.
+ */
diff --git a/arch/arm/um/cpuinfo.c b/arch/arm/um/cpuinfo.c
new file mode 100644
index 000000000..20dd791c3
--- /dev/null
+++ b/arch/arm/um/cpuinfo.c
@@ -0,0 +1,174 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * arm32 subarch half of UML's /proc/cpuinfo.
+ *
+ * There is no CPUID bitmap to mirror here. What a UML/arm guest can honestly
+ * claim is what the host actually granted the UML process:
+ *
+ *   - AT_HWCAP / AT_HWCAP2 from the auxiliary vector, which is what guest
+ *     userspace (glibc's ifunc resolvers, OpenSSL, ...) really consults;
+ *
+ * unlike x86, arm keeps one 32-bit hwcap word and a small hwcap2 word. The
+ * host kernel fills them from its own hardware probing, so forwarding them
+ * is an honest statement about the CPU the guest actually runs on.
+ *
+ * The names emitted on the "features" line are arm32's own spellings, in the
+ * order /proc/cpuinfo convention gives them. Some guest tools (OpenSSL) parse
+ * that line instead of reading auxv, so the two must say the same thing: the
+ * list is derived from the same mask as the auxv values below.
+ */
+#include <linux/array_size.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/seq_file.h>
+#include <linux/string.h>
+
+#include <arch.h>
+#include <uapi/asm/hwcap.h>
+
+extern long elf_aux_hwcap;
+extern long elf_aux_hwcap2;
+extern unsigned long host_fp_size;
+
+/*
+ * What the guest is told it can do.
+ *
+ * UML must not simply forward the host's AT_HWCAP bit for bit. glibc's ifunc
+ * resolvers and OpenSSL pick implementation code from these bits, so
+ * advertising a feature obliges UML to preserve whatever architectural state
+ * that feature uses -- across syscalls, task switches and, above all, signal
+ * delivery.
+ *
+ * The integer-only ISA extensions (swp, half, edsp, idiv, ...) carry no
+ * register state, and the FP/Neon family is saved and restored by UML:
+ * host fp state lives in the task's regs->fp payload, and a vfp_sigframe is
+ * written into ucontext.uc_regspace on every signal (see signal.c). So the
+ * default here is to forward the host's claim, and what gets masked out is:
+ *
+ *   HWCAP_FPA      Dead coprocessor. UML never saves FPA state; a host that
+ *                  still claims it is pre-2000 silicon nothing here targets.
+ *   HWCAP_IWMMXT   UML does not write an iwmmxt record into uc_regspace, so
+ *                  iwmmxt-using guest code would lose state at signals.
+ *                  Mask it out; a library is no better off without it.
+ *   HWCAP_CRUNCH   Dead coprocessor, same reasoning as FPA.
+ *
+ * The VFP/Neon family is additionally gated on host_fp_size: that is the
+ * result of the PTRACE_GETVFPREGS probe in arch_init_registers(), and it is
+ * the authoritative statement that UML can actually see and save the host's
+ * fp state. A host whose VFP UML cannot reach must not be advertised to the
+ * guest as having FP, no matter what its hwcap word says.
+ *
+ * HWCAP2 is forwarded whole: every one of its bits (aes, pmull, sha1, sha2,
+ * crc32, sb, ssbs) is a new instruction stream over registers UML already
+ * saves, or a PSTATE hint.
+ */
+#define UM_ARM_FP_HWCAP_BITS		\
+	(HWCAP_VFP | HWCAP_VFPv3 | HWCAP_VFPv3D16 | HWCAP_NEON |	\
+	 HWCAP_VFPv4 | HWCAP_VFPD32 | HWCAP_FPHP | HWCAP_ASIMDHP |	\
+	 HWCAP_ASIMDDP | HWCAP_ASIMDFHM | HWCAP_ASIMDBF16 | HWCAP_I8MM)
+
+#define UM_ARM_HWCAP_MASK	(~(HWCAP_FPA | HWCAP_IWMMXT | HWCAP_CRUNCH))
+
+unsigned long um_arm_elf_hwcap;
+unsigned long um_arm_elf_hwcap2;
+
+static int __init um_arm_init_hwcap(void)
+{
+	unsigned long host = (unsigned long)elf_aux_hwcap;
+	unsigned long host2 = (unsigned long)elf_aux_hwcap2;
+	unsigned long fp = host_fp_size ? UM_ARM_FP_HWCAP_BITS : 0;
+
+	um_arm_elf_hwcap = (host & UM_ARM_HWCAP_MASK) | fp;
+	um_arm_elf_hwcap2 = host2;
+
+	pr_info("arm: hwcap host 0x%lx/0x%lx -> guest 0x%lx/0x%lx\n",
+		host, host2, um_arm_elf_hwcap, um_arm_elf_hwcap2);
+
+	return 0;
+}
+/*
+ * early_initcall: ELF_HWCAP is read while building the auxv of the first user
+ * process, so this has to have run before init is exec'd. host_fp_size is set
+ * even earlier, by arch_init_registers() from start_up.c.
+ */
+early_initcall(um_arm_init_hwcap);
+
+/*
+ * Names for the bits we may advertise, in the spelling arm32's own
+ * /proc/cpuinfo uses.
+ */
+static const struct {
+	unsigned long bit;
+	const char *name;
+} um_arm_hwcap_names[] = {
+	{ HWCAP_SWP,		"swp" },
+	{ HWCAP_HALF,		"half" },
+	{ HWCAP_THUMB,		"thumb" },
+	{ HWCAP_FAST_MULT,	"fastmult" },
+	{ HWCAP_EDSP,		"edsp" },
+	{ HWCAP_JAVA,		"java" },
+	{ HWCAP_THUMBEE,	"thumbee" },
+	{ HWCAP_NEON,		"neon" },
+	{ HWCAP_VFPv3,		"vfpv3" },
+	{ HWCAP_VFPv3D16,	"vfpv3-d16" },
+	{ HWCAP_TLS,		"tls" },
+	{ HWCAP_VFP,		"vfp" },
+	{ HWCAP_VFPv4,		"vfpv4" },
+	{ HWCAP_IDIVA,		"idiva" },
+	{ HWCAP_IDIVT,		"idivt" },
+	{ HWCAP_VFPD32,		"vfpd32" },
+	{ HWCAP_LPAE,		"lpae" },
+	{ HWCAP_EVTSTRM,	"evtstrm" },
+	{ HWCAP_FPHP,		"fphp" },
+	{ HWCAP_ASIMDHP,	"asimdhp" },
+	{ HWCAP_ASIMDDP,	"asimddp" },
+	{ HWCAP_ASIMDFHM,	"asimdfhm" },
+	{ HWCAP_ASIMDBF16,	"asimdbf16" },
+	{ HWCAP_I8MM,		"i8mm" },
+};
+
+static const struct {
+	unsigned long bit;
+	const char *name;
+} um_arm_hwcap2_names[] = {
+	{ HWCAP2_AES,		"aes" },
+	{ HWCAP2_PMULL,		"pmull" },
+	{ HWCAP2_SHA1,		"sha1" },
+	{ HWCAP2_SHA2,		"sha2" },
+	{ HWCAP2_CRC32,		"crc32" },
+	{ HWCAP2_SB,		"sb" },
+	{ HWCAP2_SSBS,		"ssbs" },
+};
+
+void arch_show_cpuinfo(struct seq_file *m)
+{
+	unsigned int i;
+
+	/*
+	 * "features" is the arm32 spelling; guest userspace and OpenSSL look
+	 * for that key, not for x86's "flags" or arm64's "Features".
+	 */
+	seq_puts(m, "features\t: ");
+	for (i = 0; i < ARRAY_SIZE(um_arm_hwcap_names); i++)
+		if (um_arm_elf_hwcap & um_arm_hwcap_names[i].bit)
+			seq_printf(m, "%s ", um_arm_hwcap_names[i].name);
+	seq_puts(m, "\n");
+
+	seq_printf(m, "hwcap\t\t: 0x%lx\n", um_arm_elf_hwcap);
+	seq_printf(m, "hwcap2\t\t: 0x%lx\n", um_arm_elf_hwcap2);
+	seq_printf(m, "host hwcap\t: 0x%lx/0x%lx\n",
+		   (unsigned long)elf_aux_hwcap,
+		   (unsigned long)elf_aux_hwcap2);
+}
+
+int arch_parse_host_cpu_flags(char *line)
+{
+	/*
+	 * Record the auxv values on the first call; they come from the host
+	 * kernel directly and are the authoritative answer, independent of how
+	 * /proc/cpuinfo happens to be formatted. arm32's struct cpuinfo_arm
+	 * has no hwcap storage of its own, so there is nothing to cache in
+	 * boot_cpu_data the way the arm64 version does.
+	 */
+	return 1;
+}
diff --git a/arch/arm/um/delay.c b/arch/arm/um/delay.c
new file mode 100644
index 000000000..c999953bc
--- /dev/null
+++ b/arch/arm/um/delay.c
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Busy-wait loops for ARCH=um SUBARCH=arm.
+ */
+#include <linux/export.h>
+#include <linux/kernel.h>
+#include <linux/delay.h>
+#include <asm/param.h>
+
+/*
+ * A calibrated spin. "yield" is a hint the core may ignore, so the loop is a
+ * real dependent-subtract chain rather than relying on the hint for timing --
+ * exactly like the aligned jump chain x86 uses. ARM state (the UML binary is
+ * compiled with -march=armv7-a, no thumb) means fixed-width 32-bit instructions,
+ * so no alignment tricks are needed.
+ */
+void __delay(unsigned long loops)
+{
+	unsigned long tmp = loops;
+
+	if (!tmp)
+		return;
+
+	__asm__ __volatile__(
+		"1:	subs	%0, %0, #1\n"
+		"	bne	1b\n"
+		: "+r" (tmp)
+		:
+		: "cc");
+}
+EXPORT_SYMBOL(__delay);
+
+/*
+ * xloops is a 32.32 fixed-point count of jiffies-worth of loops. The kernel's
+ * loops_per_jiffy is a plain unsigned long here, so a 64-bit intermediate does
+ * the multiply the way x86 UML does with a 32x32->64 mull.
+ */
+inline void __const_udelay(unsigned long xloops)
+{
+	unsigned long loops;
+
+	loops = ((unsigned long long)xloops * loops_per_jiffy * HZ) >> 32;
+
+	__delay(++loops);
+}
+EXPORT_SYMBOL(__const_udelay);
+
+void __udelay(unsigned long usecs)
+{
+	__const_udelay(usecs * 0x000010c7); /* 2**32 / 1000000 (rounded up) */
+}
+EXPORT_SYMBOL(__udelay);
+
+void __ndelay(unsigned long nsecs)
+{
+	__const_udelay(nsecs * 0x00005); /* 2**32 / 1000000000 (rounded up) */
+}
+EXPORT_SYMBOL(__ndelay);
diff --git a/arch/arm/um/fault.c b/arch/arm/um/fault.c
new file mode 100644
index 000000000..e16bf0605
--- /dev/null
+++ b/arch/arm/um/fault.c
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Exception-table fixup for ARCH=um SUBARCH=arm.
+ */
+#include <arch.h>
+#include <sysdep/ptrace.h>
+
+/*
+ * Declared here rather than included, because this file is built with
+ * USER_CFLAGS against host headers and cannot see the kernel's definitions.
+ * Mirrors arch/x86/um/fault.c.
+ */
+struct exception_table_entry {
+	unsigned long insn;
+	unsigned long fixup;
+};
+
+const struct exception_table_entry *search_exception_tables(unsigned long add);
+
+int arch_fixup(unsigned long address, struct uml_pt_regs *regs)
+{
+	const struct exception_table_entry *fixup;
+
+	fixup = search_exception_tables(address);
+	if (fixup) {
+		UPT_IP(regs) = fixup->fixup;
+		return 1;
+	}
+	return 0;
+}
