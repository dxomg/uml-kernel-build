+
+/*
+ * Subarch half of struct cpuinfo_um.
+ *
+ * arm has no CPUID-style feature bitmap to mirror into boot_cpu_data.
+ * What the guest may rely on is not cached here at all: it is the host's
+ * AT_HWCAP/AT_HWCAP2, published through the um_arm_elf_hwcap/um_arm_elf_hwcap2
+ * globals and the "features" line of /proc/cpuinfo, both generated from
+ * the same mask in arch/arm/um/cpuinfo.c. arch_parse_host_cpu_flags()
+ * therefore answers 1 for every host cpuinfo line rather than parsing one,
+ * and the struct needs no storage of its own.
+ */
+struct arch_cpuinfo {
+};
+
+#endif /* __UM_ARM_CPUINFO_H */
diff --git a/arch/arm/um/asm/elf.h b/arch/arm/um/asm/elf.h
new file mode 100644
index 000000000..91dc43515
--- /dev/null
+++ b/arch/arm/um/asm/elf.h
@@ -0,0 +1,140 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UM_ARM_ELF_H
+#define __UM_ARM_ELF_H
+
+/*
+ * UML half of <asm/elf.h> for ARCH=um SUBARCH=arm.
+ *
+ * The parent arch/arm/include/asm/elf.h is static and mostly reusable, but it
+ * declares five functions defined in arch/arm/kernel/ and arch/arm/mm/
+ * (elf_check_arch, elf_platform, arm_elf_read_implies_exec,
+ * elf_set_personality, arch_setup_additional_pages) that are not built for
+ * a UML guest, and it hardwires a 4K page size and a 0x400000 PIE base that
+ * belong to a real arm board rather than to a guest on whatever host the
+ * UML binary runs on. This file keeps the UML-applicable part and drops the
+ * rest; wherever a macro is absent here, the generic fallbacks in
+ * include/linux/elf.h and include/linux/elfcore.h take over, so the dropped
+ * externs simply do not need definitions.
+ */
+#include <linux/elf-em.h>
+#include <asm/ptrace.h>
+#include <asm/user.h>
+#include <skas.h>
+
+#define elf_check_arch(x) ((x)->e_machine == EM_ARM)
+
+#define ELF_CLASS	ELFCLASS32
+#define ELF_DATA	ELFDATA2LSB
+#define ELF_ARCH	EM_ARM
+
+/*
+ * The R_ARM_* relocation numbers arch/arm/kernel/module.c's
+ * apply_relocate() switch is built against: module.c is compiled in as
+ * subarch code (arch/arm/um/Makefile) and so includes this shadow, not
+ * the parent arch/arm/include/asm/elf.h, which is where the constants
+ * live in a real arm build. They are plain ABI values, independent of
+ * the board-specific declarations this file drops.
+ */
+#define R_ARM_NONE		0
+#define R_ARM_PC24		1
+#define R_ARM_ABS32		2
+#define R_ARM_REL32		3
+#define R_ARM_CALL		28
+#define R_ARM_JUMP24		29
+#define R_ARM_TARGET1		38
+#define R_ARM_V4BX		40
+#define R_ARM_PREL31		42
+#define R_ARM_MOVW_ABS_NC	43
+#define R_ARM_MOVT_ABS		44
+#define R_ARM_MOVW_PREL_NC	45
+#define R_ARM_MOVT_PREL		46
+#define R_ARM_ALU_PC_G0_NC	57
+#define R_ARM_ALU_PC_G1_NC	59
+#define R_ARM_LDR_PC_G2		63
+
+#define R_ARM_THM_CALL		10
+#define R_ARM_THM_JUMP24	30
+#define R_ARM_THM_MOVW_ABS_NC	47
+#define R_ARM_THM_MOVT_ABS	48
+#define R_ARM_THM_MOVW_PREL_NC	49
+#define R_ARM_THM_MOVT_PREL	50
+
+typedef unsigned long elf_greg_t;
+typedef unsigned long elf_freg_t[3];
+
+/*
+ * NT_PRSTATUS carries the 18-word classic register block -- r0-r10, fp, ip,
+ * sp, lr, pc, cpsr, orig_r0 -- which is exactly struct user_regs_struct and,
+ * on a 32-bit host, exactly the first 18 entries of the UML register model.
+ * The slots UML appends past the host ABI (synthesised syscall number,
+ * kernel bookkeeping) are not part of a core file and are not copied.
+ */
+#define ELF_NGREG (sizeof(struct user_regs_struct) / sizeof(elf_greg_t))
+typedef elf_greg_t elf_gregset_t[ELF_NGREG];
+
+typedef struct user_fp elf_fpregset_t;
+
+/*
+ * A fresh arm process starts with r0 holding the SVR4 atexit handler
+ * pointer; 0 means there is none. The rest of the register file is what
+ * execve(2) leaves it, which is the host kernel's business, not the
+ * guest's.
+ */
+#define ELF_PLAT_INIT(regs, load_addr)	(PT_REGS_R0(regs) = 0)
+
+/*
+ * A plain compound statement, not do/while(0): include/linux/elfcore.h
+ * invokes this without a trailing semicolon.
+ */
+#define ELF_CORE_COPY_REGS(pr_reg, _regs)				\
+	{							\
+		int __i;						\
+							\
+		for (__i = 0; __i < ELF_NGREG; __i++)		\
+			(pr_reg)[__i] = (_regs)->regs.gp[__i];	\
+	}
+
+/*
+ * The host's own AT_PLATFORM, captured from the UML process's auxv in
+ * arch/um/os-Linux/elf_aux.c, is the honest answer for the guest: it is
+ * the platform string of the machine actually running. The fallback only
+ * matters on hosts that publish no AT_PLATFORM at all.
+ */
+extern char *elf_aux_platform;
+#define ELF_PLATFORM_FALLBACK "armv7l"
+#define ELF_PLATFORM (elf_aux_platform ?: ELF_PLATFORM_FALLBACK)
+
+/*
+ * Sanitised in arch/arm/um/cpuinfo.c: the guest is told only about
+ * features whose state UML actually preserves. Deliberately not the host's
+ * raw AT_HWCAP -- see the allowlist there. ELF_HWCAP2 feeds the
+ * #ifdef-guarded AT_HWCAP2 entry in fs/binfmt_elf.c.
+ */
+extern unsigned long um_arm_elf_hwcap;
+extern unsigned long um_arm_elf_hwcap2;
+#define ELF_HWCAP	(um_arm_elf_hwcap)
+#define ELF_HWCAP2	(um_arm_elf_hwcap2)
+
+/*
+ * PAGE_SIZE, not 4096: an arm host may run a 4K or a 64K page kernel, and
+ * a UML guest's page size always equals its host's.
+ */
+#define ELF_EXEC_PAGESIZE PAGE_SIZE
+
+/*
+ * Two thirds of the guest address space up, matching x86 UML and the arm64
+ * port: the UML kernel binary and its guest physical memory mappings live
+ * elsewhere, and glibc's loader is happiest with a top-down region of its
+ * own.
+ */
+#define ELF_ET_DYN_BASE (2 * TASK_SIZE / 3)
+
+#define SET_PERSONALITY(ex) do {} while (0)
+
+/*
+ * Core dumps walk the regset view (arch/arm/um/ptrace.c) rather than the
+ * legacy register dump, so no struct user plumbing is needed for coredumps.
+ */
+#define CORE_DUMP_USE_REGSET
+
+#endif /* __UM_ARM_ELF_H */
diff --git a/arch/arm/um/asm/hwcap.h b/arch/arm/um/asm/hwcap.h
new file mode 100644
index 000000000..40af7dd58
--- /dev/null
+++ b/arch/arm/um/asm/hwcap.h
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UM_ARM_HWCAP_H
+#define __UM_ARM_HWCAP_H
+
+/*
+ * arch/arm/include/uapi/asm/ptrace.h includes <asm/hwcap.h>, which in a real
+ * arm build lands on the kernel-side header: KERNEL_HWCAP_* ordinals and,
+ * through <asm/cpufeature.h>, the whole cpucaps and alternatives machinery.
+ *
+ * A UML guest has no cpucaps -- it never probes ID registers, and its notion
+ * of "what this CPU can do" is the AT_HWCAP/AT_HWCAP2 the host handed the
+ * UML process (see arch/arm/um/cpuinfo.c). Only the uapi HWCAP_* bit
+ * definitions are meaningful here, and those are what guest userspace sees
+ * anyway.
+ */
+#include <uapi/asm/hwcap.h>
+
+#endif /* __UM_ARM_HWCAP_H */
diff --git a/arch/arm/um/asm/ldt.h b/arch/arm/um/asm/ldt.h
new file mode 100644
index 000000000..f9b35ddbc
