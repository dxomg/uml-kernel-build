diff --git a/arch/arm/um/asm/checksum.h b/arch/arm/um/asm/checksum.h
new file mode 100644
index 000000000..ea45419d5
--- /dev/null
+++ b/arch/arm/um/asm/checksum.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UM_ARM_CHECKSUM_H
+#define __UM_ARM_CHECKSUM_H
+
+/*
+ * arm has hand-written checksum helpers in arch/arm/lib (csum_partial,
+ * csum_partial_copy_*, ip_fast_csum), declared in the parent
+ * arch/arm/include/asm/checksum.h. Those are kernel-only assembly written
+ * against the EL1 uaccess model, and arch/arm/lib is not built for ARCH=um,
+ * so their declarations would dangle.
+ *
+ * Fall back to the generic C versions instead: lib/checksum.c (selected by
+ * GENERIC_CSUM in arch/arm/um/Kconfig) supplies csum_partial and friends,
+ * and asm-generic/checksum.h declares them with the matching signatures.
+ * That is the right cost here -- the guest's network path is a host socket
+ * anyway, so this is not on any hot path.
+ */
+#include <asm-generic/checksum.h>
+
+#endif /* __UM_ARM_CHECKSUM_H */
diff --git a/arch/arm/um/asm/cpufeatures.h b/arch/arm/um/asm/cpufeatures.h
new file mode 100644
index 000000000..376b1edd0
--- /dev/null
+++ b/arch/arm/um/asm/cpufeatures.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UM_ARM_CPUFEATURES_H
+#define __UM_ARM_CPUFEATURES_H
+
+/*
+ * Shadow of <asm/cpufeatures.h> for ARCH=um SUBARCH=arm. The header itself
+ * is an x86 thing (CPUID bit numbers), but the generic UML thread_struct
+ * (arch/um/include/asm/processor-generic.h) and the generated capflags.c
+ * are sized and indexed by its NCAPINTS/NBUGINTS and X86_FEATURE_* /
+ * X86_BUG_* names, and nothing else in the tree provides them for any
+ * other subarch.
+ *
+ * arch/um/Makefile puts -Iarch/$(SUBARCH)/um ahead of -Iarch/$(SUBARCH)/include
+ * and the uapi include dirs, so this file shadows <asm/cpufeatures.h> for
+ * every translation unit of the build. The x86 header is pure #define
+ * (no includes) and the tree always ships it, so pull it in by relative
+ * path: quoted includes resolve against this file's own directory, and
+ * everything stays in sync with the kernel version being built.
+ */
+#include "../../../x86/include/asm/cpufeatures.h"
+
+#endif /* __UM_ARM_CPUFEATURES_H */
diff --git a/arch/arm/um/asm/cpuinfo.h b/arch/arm/um/asm/cpuinfo.h
