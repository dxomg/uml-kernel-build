+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SIGSEGV handler that runs *inside* the stub process, with no libc and no
+ * stack protector. It records where and why the fault happened into the stub's
+ * data page and then traps, handing control back to the UML kernel.
+ */
+#include <sysdep/stub.h>
+#include <sysdep/faultinfo.h>
+#include <sysdep/mcontext.h>
+#include <sys/ucontext.h>
+
+void __attribute__ ((__section__ (".__syscall_stub")))
+stub_segv_handler(int sig, siginfo_t *si, void *p)
+{
+	struct faultinfo *f = get_stub_data();
+	ucontext_t *uc = p;
+
+	GET_FAULTINFO_FROM_MC(*f, &uc->uc_mcontext);
+	trap_myself();
+}
diff --git a/arch/arm/um/sys_call_table.c b/arch/arm/um/sys_call_table.c
new file mode 100644
index 000000000..985ab603c
--- /dev/null
+++ b/arch/arm/um/sys_call_table.c
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * System call table for UML/arm.
+ *
+ * arm uses the classic register ABI: the number in r7, arguments r0-r5,
+ * result in r0. The table body and its size are committed under
+ * arch/arm/um/asm/ as syscall_table_eabi.h and unistd-nr.h, generated from
+ * arch/arm/tools/syscall.tbl by the parent's own scripts; each header says
+ * how to regenerate it. They cannot come out of the kbuild flow: the UML
+ * build takes the parent through archheaders (the uapi step) only, and
+ * arch/arm's archprepare kapi step that would emit them into
+ * arch/arm/include/generated/asm/ is never run.
+ *
+ * The parent arch/arm kernel implements six of these entry points as
+ * wrappers in arch/arm/kernel/ (sys_mmap2, the two sigreturn variants,
+ * the two statfs64 variants, sys_arm_fadvise64_64), which are not built
+ * for ARCH=um; this subarch provides them in syscalls.c and signal.c.
+ *
+ * handle_syscall() in arch/um/kernel/skas/syscall.c unpacks the six
+ * arguments itself and calls the syscall with them directly, exactly as x86
+ * UML does, so the table holds the plain sys_* functions and the pt_regs
+ * wrappers are neither built nor needed. The calls pass six words through
+ * sys_call_ptr_t; entries that use fewer simply do not read the rest.
+ */
+#include <linux/linkage.h>
+#include <linux/sys.h>
+#include <linux/cache.h>
+#include <asm/syscall.h>
+#include <asm/unistd.h>
+
+extern asmlinkage long sys_ni_syscall(unsigned long, unsigned long,
+				      unsigned long, unsigned long,
+				      unsigned long, unsigned long);
+
+/*
+ * A UML guest only enters its own 32-bit EABI system calls, so every dual
+ * entry resolves to the native side. The macro chain is what makes the same
+ * header work for both the externs and the initializer: WITH_COMPAT expands
+ * to __SYSCALL at the use, which is whatever form is defined at that point.
+ */
+#define __SYSCALL_WITH_COMPAT(nr, native, compat)	__SYSCALL(nr, native)
+
+#define __SYSCALL(nr, sym) extern asmlinkage long sym(unsigned long, unsigned long, unsigned long, unsigned long, unsigned long, unsigned long);
+#include <asm/syscall_table_eabi.h>
+#undef  __SYSCALL
+
+#include <asm/unistd-nr.h>
+
+#define __SYSCALL(nr, sym) [nr] = sym,
+const sys_call_ptr_t sys_call_table[__NR_syscalls] ____cacheline_aligned = {
+	[0 ... __NR_syscalls - 1] = sys_ni_syscall,
+#include <asm/syscall_table_eabi.h>
+};
+#undef  __SYSCALL
+#undef  __SYSCALL_WITH_COMPAT
+
+int syscall_table_size = sizeof(sys_call_table);
diff --git a/arch/arm/um/syscalls.c b/arch/arm/um/syscalls.c
new file mode 100644
index 000000000..be9c7f5cf
--- /dev/null
+++ b/arch/arm/um/syscalls.c
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Architecture-specific syscalls for UML/arm.
+ *
+ * The arm EABI table (arch/arm/tools/syscall.tbl) names six entry points
+ * that do not exist in the generic kernel:
+ *
+ *	119  sigreturn          sys_sigreturn_wrapper
+ *	173  rt_sigreturn      sys_rt_sigreturn_wrapper
+ *	192  mmap2             sys_mmap2
+ *	266  statfs64          sys_statfs64_wrapper
+ *	267  fstatfs64         sys_fstatfs64_wrapper
+ *	270  arm_fadvise64_64  sys_arm_fadvise64_64
+ *
+ * The first, fourth, fifth and sixth are implemented in
+ * arch/arm/kernel/entry-common.S and arch/arm/kernel/sys_arm.c; the two
+ * sigreturn wrappers are likewise asm. None of that is built for ARCH=um, so
+ * they are repeated here, as x86 UML repeats its own entry wrappers and the
+ * arm64 port repeats its sys_mmap.
+ *
+ * Every table entry is called through sys_call_ptr_t with six unsigned long
+ * arguments, so each definition below is written with the entry's native
+ * prototype: the extra words simply land in registers the callee does not
+ * read. The two sigreturn wrappers are no-argument calls, but the table
+ * shape still applies, so they ignore whatever is in r0-r5.
+ */
+#include <linux/sched.h>
+#include <linux/sched/mm.h>
+#include <linux/syscalls.h>
+#include <linux/uaccess.h>
+#include <linux/stat.h>
+#include <asm/ptrace.h>
+#include <registers.h>
+#include <os.h>
+
+/*
+ * arm32 sys_mmap takes a byte offset; mmap2 takes a page offset, which is
+ * what distinguishes it. The parent implements sys_mmap2 in entry-common.S
+ * as "str r5, [sp, #4]; b sys_mmap_pgoff", i.e. the page unit is passed
+ * through unchanged -- no offset_in_page check, because a fractional page
+ * is not a meaningful value in page units and the guest cannot ask for one.
+ */
+SYSCALL_DEFINE6(mmap2, unsigned long, addr, unsigned long, len,
+		unsigned long, prot, unsigned long, flags,
+		unsigned long, fd, unsigned long, pgoff)
+{
+	return ksys_mmap_pgoff(addr, len, prot, flags, fd, pgoff);
+}
+
+/*
+ * 32-bit userspace passes sizeof(struct statfs) in the size argument, but
+ * the kernel wants the size of its own struct statfs64. The parent fixes
+ * this up in registers before branching to the generic implementation:
+ * teq r1, #88; moveq r1, #84. Same fix, in C.
+ */
+asmlinkage long sys_statfs64_wrapper(const char __user *path, size_t sz,
+				     struct statfs64 __user *buf)
+{
+	if (sz == 88)
+		sz = 84;
+
+	return sys_statfs64(path, sz, buf);
+}
+
+asmlinkage long sys_fstatfs64_wrapper(unsigned int fd, size_t sz,
+				      struct statfs64 __user *buf)
+{
+	if (sz == 88)
+		sz = 84;
+
+	return sys_fstatfs64(fd, sz, buf);
+}
+
+/*
+ * EABI fadvise64_64 carries its two 64-bit arguments in register pairs --
+ * offset in r2:r3, len in r4:r5 -- with the advice argument in r1, which
+ * differs from the generic fadvise64_64 order (advice last). The table's
+ * six-word call delivers the guest's r0-r5 straight into the callee's
+ * arguments, so the reordering happens exactly as the parent does it in
+ * sys_arm.c.
+ */
+asmlinkage long sys_arm_fadvise64_64(int fd, int advice,
+				     loff_t offset, loff_t len)
+{
+	return ksys_fadvise64_64(fd, offset, len, advice);
+}
+
+/*
+ * The sigreturn wrappers are defined in signal.c, where the frame code
+ * they share lives; this file exists for the table's remaining entries.
+ */
+
+void arch_switch_to(struct task_struct *to)
+{
+	/*
+	 * Nothing to do, and it is important that nothing is done.
+	 *
+	 * arm32 userspace owns R8 outright: the EABI psABI puts the thread
+	 * pointer in R8, which guest code sets with a plain store -- arm32
+	 * has no set_thread_area or any other syscall for it. UML captures
+	 * whatever value the guest left in get_host_regs() or
+	 * get_regs_from_mc() -- R8 is an ordinary word of the register
+	 * block -- keeps it in the task's own HOST_TLS register slot, and
+	 * writes it back in put_host_regs(). Since that slot is part of the
+	 * per-task register file, switching tasks already switches the TLS.
+	 *
+	 * Reinstating thread.arch.tp_value here instead would be actively
+	 * wrong: that field is only ever set by CLONE_SETTLS, so for a
+	 * thread that set R8 itself -- which is every normal thread -- it is
+	 * zero, and copying it over the live value wipes the guest's thread
+	 * pointer on the first context switch. Any libc that compares the
+	 * live thread pointer against its own copy notices immediately.
+	 */
+}
diff --git a/arch/arm/um/sysrq.c b/arch/arm/um/sysrq.c
new file mode 100644
index 000000000..99d77ce17
--- /dev/null
+++ b/arch/arm/um/sysrq.c
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/pid.h>
+#include <linux/sched.h>
+#include <linux/sched/debug.h>
+#include <linux/utsname.h>
+#include <asm/current.h>
+#include <asm/ptrace.h>
+
+void show_regs(struct pt_regs *regs)
+{
+	int i;
+
+	printk("\n");
+	print_modules();
+	printk(KERN_INFO "Pid: %d, comm: %.20s %s %s\n", task_pid_nr(current),
+	       current->comm, print_tainted(), init_utsname()->release);
+
+	printk(KERN_INFO "pc : %pS\n", (void *)PT_REGS_IP(regs));
+	printk(KERN_INFO "lr : %pS\n", (void *)PT_REGS_LR(regs));
+	printk(KERN_INFO "sp : %08lx  cpsr : %08lx\n",
+	       PT_REGS_SP(regs), PT_REGS_CPSR(regs));
+	printk(KERN_INFO "fp : %08lx  ip : %08lx\n",
+	       PT_REGS_X(regs, HOST_FP), PT_REGS_X(regs, HOST_IP));
+
+	/*
+	 * Three registers per line, highest first, so an arm developer can
+	 * read a UML oops the same way arch/arm/kernel/traps.c prints them.
+	 */
+	for (i = 10; i >= 0; i -= 3) {
+		if (i >= 3)
+			printk(KERN_INFO "r%-2d: %08lx r%-2d: %08lx r%-2d: %08lx\n",
+			       i, PT_REGS_X(regs, HOST_R0 + i),
+			       i - 1, PT_REGS_X(regs, HOST_R0 + i - 1),
+			       i - 2, PT_REGS_X(regs, HOST_R0 + i - 2));
+		else if (i == 2)
+			printk(KERN_INFO "r2 : %08lx r1 : %08lx r0 : %08lx\n",
+			       PT_REGS_X(regs, HOST_R0 + 2),
+			       PT_REGS_X(regs, HOST_R0 + 1),
+			       PT_REGS_X(regs, HOST_R0));
+		else
+			printk(KERN_INFO "r0 : %08lx\n",
+			       PT_REGS_X(regs, HOST_R0));
+	}
+}
diff --git a/arch/arm/um/tls.c b/arch/arm/um/tls.c
new file mode 100644
index 000000000..2de09b400
--- /dev/null
+++ b/arch/arm/um/tls.c
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Guest TLS for ARCH=um SUBARCH=arm.
+ *
+ * arm32 thread-local storage is the r8 register: the psABI assigns it to the
+ * thread pointer, and every mainstream arm32 libc (glibc, musl, bionic)
+ * reads TLS from there directly, exactly as arm64 code reads TPIDR_EL0.
+ * There is no set_thread_area(2) and no descriptor table.
+ *
+ * That means UML never has to intercept a TLS *change*; it only has to make
+ * sure the right value is in the register when it resumes a given guest
+ * thread, since several guest threads share one stub process. r8 is an
+ * ordinary general-purpose register in the host's PTRACE_GETREGS and in the
+ * signal frame, so it travels in the per-task register file (gp[HOST_TLS])
+ * and is restored by every put_host_regs() and sigreturn.
+ */
+#include <linux/sched.h>
+#include <asm/ptrace.h>
+
+void clear_flushed_tls(struct task_struct *task)
+{
+}
+
+int arch_set_tls(struct task_struct *t, unsigned long tls)
+{
+	/*
+	 * CLONE_SETTLS: remember the value so the next switch to this task
+	 * installs it. R8 is part of user_regs_struct, so it can be stashed
+	 * straight into the register file; the arch field keeps the same
+	 * record arm64 does, of what CLONE_SETTLS asked for, in case
+	 * something ever has to reinstall it.
+	 */
+	t->thread.arch.tp_value = tls;
+	t->thread.regs.regs.gp[HOST_TLS] = tls;
+
+	return 0;
+}
diff --git a/arch/arm/um/user-offsets.c b/arch/arm/um/user-offsets.c
new file mode 100644
index 000000000..1636ab005
--- /dev/null
+++ b/arch/arm/um/user-offsets.c
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Generates include/generated/user_constants.h for ARCH=um SUBARCH=arm.
+ *
+ * This file is compiled with USER_CFLAGS against the *host* headers, so
+ * everything it sees describes the arm32 process UML runs as.
+ */
+#include <stdio.h>
+#include <stddef.h>
+#include <signal.h>
+#include <poll.h>
+#include <sys/mman.h>
+#include <sys/user.h>
+#include <asm/ptrace.h>
+#include <asm/types.h>
+#include <linux/kbuild.h>
+
+#define DEFINE_LONGS(sym, val)	\
+	COMMENT(#val " / sizeof(unsigned long)");	\
+	DEFINE(sym, val / sizeof(unsigned long))
+
+/* workaround for a warning with -Wmissing-prototypes */
+void foo(void);
+
+void foo(void)
+{
+	/*
+	 * The host register file is struct user_regs in arm glibc's
+	 * <sys/user.h> -- 18 x unsigned long (there is no user_regs_struct
+	 * on arm, that is an x86 type). It mirrors the UGL kernel-side
+	 * struct user_regs_struct (arch/arm/um/asm/ptrace.h):
+	 *
+	 *	regs.uregs[0..10] = r0-r10
+	 *	regs.uregs[11]     = fp (r11)
+	 *	regs.uregs[12]     = ip (r12)
+	 *	regs.uregs[13]     = sp
+	 *	regs.uregs[14]     = lr
+	 *	regs.uregs[15]     = pc
+	 *	regs.uregs[16]     = cpsr
+	 *	regs.uregs[17]     = orig_r0
+	 *
+	 * Unlike arm64 there is no separate special-register set at all: SP,
+	 * LR and PC are ordinary members, and the original first argument is
+	 * already exposed by the host kernel at uregs[17]. Every slot is one
+	 * unsigned long on this target, so the indices are simply word
+	 * offsets into the 72-byte PTRACE_GETREGS payload.
+	 */
+	DEFINE_LONGS(HOST_R0,  offsetof(struct user, regs.uregs[0]));
+	DEFINE_LONGS(HOST_R1,  offsetof(struct user, regs.uregs[1]));
+	DEFINE_LONGS(HOST_R2,  offsetof(struct user, regs.uregs[2]));
+	DEFINE_LONGS(HOST_R3,  offsetof(struct user, regs.uregs[3]));
+	DEFINE_LONGS(HOST_R4,  offsetof(struct user, regs.uregs[4]));
+	DEFINE_LONGS(HOST_R5,  offsetof(struct user, regs.uregs[5]));
+	DEFINE_LONGS(HOST_R6,  offsetof(struct user, regs.uregs[6]));
+	DEFINE_LONGS(HOST_R7,  offsetof(struct user, regs.uregs[7]));
+	DEFINE_LONGS(HOST_R8,  offsetof(struct user, regs.uregs[8]));
+	DEFINE_LONGS(HOST_R9,  offsetof(struct user, regs.uregs[9]));
+	DEFINE_LONGS(HOST_R10, offsetof(struct user, regs.uregs[10]));
+
+	DEFINE_LONGS(HOST_FP,   offsetof(struct user, regs.uregs[11]));
+	DEFINE_LONGS(HOST_IP,   offsetof(struct user, regs.uregs[12]));
+	DEFINE_LONGS(HOST_SP,   offsetof(struct user, regs.uregs[13]));
+	DEFINE_LONGS(HOST_LR,   offsetof(struct user, regs.uregs[14]));
+	DEFINE_LONGS(HOST_PC,   offsetof(struct user, regs.uregs[15]));
+	DEFINE_LONGS(HOST_CPSR, offsetof(struct user, regs.uregs[16]));
+	DEFINE_LONGS(HOST_ORIG_R0, offsetof(struct user, regs.uregs[17]));
+
+	/*
+	 * UM_FRAME_SIZE is the size of the register block that is actually
+	 * exchanged with the host via PTRACE_GETREGS/SETREGS. It is the
+	 * bound for peek_user/poke_user and for every ptrace transfer.
+	 */
+	DEFINE(UM_FRAME_SIZE, sizeof(struct user_regs));
+
+	/*
+	 * One slot past the end of the host regset, synthesised by UML:
+	 *
+	 *   HOST_SYSCALL_NR  the in-flight syscall number. The host keeps it
+	 *                    in r7, but UML cannot read it from there: at a
+	 *                    syscall stop r7 is the number, while at every
+	 *                    other stop it is just a scratch register the
+	 *                    stub happened to hold. r7 is only ever
+	 *                    authoritative on the syscall-stop paths, so UML
+	 *                    copies it here where it stays, and x86 gets the
+	 *                    same treatment as orig_ax inside its regset.
+	 *
+	 * HOST_ORIG_R0 needs no synthesised slot: unlike arm64's x0, the host
+	 * exposes the original first argument inside the regset at ureg[17].
+	 */
+	DEFINE(HOST_SYSCALL_NR, sizeof(struct user_regs) / sizeof(unsigned long));
+	DEFINE(UM_MAX_REG_NR,   sizeof(struct user_regs) / sizeof(unsigned long) + 1);
+
+	/*
+	 * Guest TLS. arm32 userland owns R8 outright (userspace sets it with
+	 * "mov r8, #off" style TLS access or the set_tls syscall), so the slot
+	 * is not appended here: it is the ordinary regs.uregs[8] slot, and
+	 * arch_set_tls() writes it there.
+	 */
+	DEFINE(HOST_TLS, offsetof(struct user, regs.uregs[8]) /
+			sizeof(unsigned long));
+
+	DEFINE(UM_POLLIN, POLLIN);
+	DEFINE(UM_POLLPRI, POLLPRI);
+	DEFINE(UM_POLLOUT, POLLOUT);
+
+	DEFINE(UM_PROT_READ, PROT_READ);
+	DEFINE(UM_PROT_WRITE, PROT_WRITE);
+	DEFINE(UM_PROT_EXEC, PROT_EXEC);
+}
diff --git a/arch/um/configs/arm_defconfig b/arch/um/configs/arm_defconfig
new file mode 100644
index 000000000..55412c31d
--- /dev/null
+++ b/arch/um/configs/arm_defconfig
@@ -0,0 +1,95 @@
+#
+# 4 KB pages, explicitly: guest pages are host mmap()s, so the guest's page
+# size cannot be smaller than the host's. Every arm32 host kernel runs 4 KB
+# pages, and the arm32 defconfig does not offer any other size to select --
+# arch/um/Kconfig only advertises HAVE_PAGE_SIZE_4KB for this subarch.
+#
+# The bootable-guest filesystem set, same shape as the arm64 defconfig:
+# initramfs for root, then an ELF interpreter and script runner so the guest
+# can exec its own binaries, a tmpfs/devtmpfs pair for /tmp and /dev, and
+# ext4 as the primary on-disk filesystem.
+#
+CONFIG_PAGE_SIZE_4KB=y
+CONFIG_BLK_DEV_INITRD=y
+CONFIG_RD_GZIP=y
+CONFIG_RD_XZ=y
+CONFIG_RD_ZSTD=y
+CONFIG_EXT4_FS=y
+CONFIG_EXT4_USE_FOR_EXT2=y
+CONFIG_TMPFS=y
+CONFIG_TMPFS_POSIX_ACL=y
+CONFIG_DEVTMPFS=y
+CONFIG_DEVTMPFS_MOUNT=y
+CONFIG_BINFMT_ELF=y
+CONFIG_BINFMT_SCRIPT=y
+# CONFIG_COMPACTION is not set
+CONFIG_BINFMT_MISC=m
+CONFIG_HOSTFS=y
+CONFIG_MAGIC_SYSRQ=y
+CONFIG_SYSVIPC=y
+CONFIG_POSIX_MQUEUE=y
+CONFIG_NO_HZ=y
+CONFIG_HIGH_RES_TIMERS=y
+CONFIG_BSD_PROCESS_ACCT=y
+CONFIG_IKCONFIG=y
+CONFIG_IKCONFIG_PROC=y
+CONFIG_LOG_BUF_SHIFT=14
+CONFIG_CGROUPS=y
+CONFIG_CGROUP_FREEZER=y
+CONFIG_CGROUP_DEVICE=y
+CONFIG_CPUSETS=y
+CONFIG_CGROUP_CPUACCT=y
+CONFIG_CGROUP_SCHED=y
+CONFIG_BLK_CGROUP=y
+# CONFIG_PID_NS is not set
+CONFIG_SYSFS_DEPRECATED=y
+CONFIG_CC_OPTIMIZE_FOR_SIZE=y
+CONFIG_MODULES=y
+CONFIG_MODULE_UNLOAD=y
+# UGL builds arch/arm/kernel/module.c without arch/arm/kernel/module-plts.c,
+# so the PLT-veneer lookup get_module_plt() that module.c calls when this
