@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UM_ARM_MMAN_H
+#define __UM_ARM_MMAN_H
+
+/*
+ * arch/arm/include/asm/mman.h adds arch_memory_deny_write_exec_supported()
+ * built on cpu_architecture() from <asm/system_info.h> -- cpufeature state
+ * a UML host does not have (there is no CPU architecture to read; the
+ * host kernel is whatever it is, and the only mapping discipline in play is
+ * the host's own mprotect()).
+ *
+ * UML guests report the generic default: include/linux/mman.h falls back to
+ * "unsupported" when the hook is absent, and prctl(PR_SET_MDWE) then answers
+ * -EINVAL, which is the honest answer on any host.
+ */
+#include <uapi/asm/mman.h>
+
+#endif /* __UM_ARM_MMAN_H */
diff --git a/arch/arm/um/asm/module.h b/arch/arm/um/asm/module.h
new file mode 100644
index 000000000..36abd3e17
--- /dev/null
+++ b/arch/arm/um/asm/module.h
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UM_ARM_MODULE_H
+#define __UM_ARM_MODULE_H
+
+#include <asm-generic/module.h>
+
+/*
+ * UML arm32 shadow of <asm/module.h>. UML's generated <asm/module.h>
+ * wrapper (arch/um/include/generated/asm, which the top-level Makefile
+ * puts ahead of the parent architecture's own headers) only knows the
+ * generic content; this file supplies what arch/arm/kernel/module.c --
+ * which UML builds unmodified -- still needs.
+ *
+ * arm's struct mod_arch_specific gains fields only under
+ * CONFIG_ARM_UNWIND (unwind tables) and CONFIG_ARM_MODULE_PLTS (PLT
+ * bookkeeping); neither can apply to a UML guest, so the struct stays
+ * empty, exactly as arch/arm's own copy reduces to it with those
+ * options off. UML's subarch Kconfig selects HAVE_MOD_ARCH_SPECIFIC,
+ * which is what keeps the generic copy's empty struct out of the way
+ * of the one defined here.
+ */
+struct mod_arch_specific {
+};
+
+/*
+ * arch/arm declares this for its relocation path; module.c calls it
+ * under a runtime CONFIG_ARM_MODULE_PLTS check that is always false
+ * here, so only the declaration matters. The definition lives in
+ * arch/arm/kernel/module-plts.c, which UML does not build.
+ */
+struct module;
+u32 get_module_plt(struct module *mod, unsigned long loc, unsigned long val);
+
+#endif /* __UM_ARM_MODULE_H */
diff --git a/arch/arm/um/asm/processor.h b/arch/arm/um/asm/processor.h
new file mode 100644
index 000000000..76e006be3
--- /dev/null
+++ b/arch/arm/um/asm/processor.h
@@ -0,0 +1,109 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UM_ARM_PROCESSOR_H
+#define __UM_ARM_PROCESSOR_H
+
+#include <linux/time-internal.h>
+
+/* include faultinfo structure */
+#include <sysdep/faultinfo.h>
+
+struct arch_thread {
+	/*
+	 * Guest TLS (R8). arm userspace owns this register outright -- the
+	 * compiler writes it with an ordinary "mov r8, ...", never a syscall
+	 * -- so UML only has to remember it across a switch between guest
+	 * threads sharing one stub process.
+	 */
+	unsigned long tp_value;
+	struct faultinfo faultinfo;
+};
+
+#define INIT_ARCH_THREAD {			\
+	.tp_value	= 0,			\
+	.faultinfo	= { 0, 0 }		\
+}
+
+#define STACKSLOTS_PER_LINE 4
+
+static inline void arch_flush_thread(struct arch_thread *thread)
+{
+	thread->tp_value = 0;
+}
+
+static inline void arch_copy_thread(struct arch_thread *from,
+				    struct arch_thread *to)
+{
+	to->tp_value = from->tp_value;
+}
+
+#define current_sp()						\
+	({ void *sp; __asm__("mov %0, sp" : "=r" (sp)); sp; })
+#define current_bp()						\
+	({ unsigned long bp; __asm__("mov %0, fp" : "=r" (bp)); bp; })
+
+#define KSTK_EIP(tsk) KSTK_REG(tsk, HOST_PC)
+#define KSTK_ESP(tsk) KSTK_REG(tsk, HOST_SP)
+#define KSTK_EBP(tsk) KSTK_REG(tsk, HOST_FP)
+
+#define ARCH_IS_STACKGROW(address) \
+	(address + 65536 + 32 * sizeof(unsigned long) >= UPT_SP(&current->thread.regs.regs))
+
+/*
+ * arch/arm/include/asm/processor.h (which this file shadows) provides the
+ * SMP-on-UP patching machinery that arch/arm/include/asm/spinlock.h
+ * relies on, and WASM() comes from arch/arm/include/asm/unified.h.
+ * Neither definition survives the shadow, so mirror them here. The UML
+ * arm32 guest is never a Thumb-2 kernel, so the non-thumb definition of
+ * WASM is the only one that applies.
+ */
+#define WASM(instr)	#instr
+
+#ifdef CONFIG_SMP
+#define __ALT_SMP_ASM(smp, up)					\
+	"9998:	" smp "\n"					\
+	"	.pushsection \".alt.smp.init\", \"a\"\n"	\
+	"	.align	2\n"					\
+	"	.long	9998b - .\n"				\
+	"	" up "\n"					\
+	"	.popsection\n"
+#else
+#define __ALT_SMP_ASM(smp, up)	up
+#endif
+
+/*
+ * Generic UML um_arch.c and asm-offsets.c reference struct alt_instr,
+ * which x86 provides through arch/x86/include/asm/alternative.h; the arm
+ * tree has no such header. The .alt.smp.init entries emitted by
+ * __ALT_SMP_ASM() above are a back-reference offset plus the replacement
+ * instruction, and UML's apply_alternatives() is a no-op that never links
+ * that section, so only the sizeof() being well-defined matters.
+ */
+struct alt_instr {
+	long offset;
+	long insn;
+};
+
+/*
+ * x86 emits PAUSE here. The arm equivalent is the YIELD hint: a no-op on
+ * cores that ignore it, and on a shared or virtualised core it asks the
+ * scheduler to offer the slot to a sibling.
+ */
+static __always_inline void native_pause(void)
+{
+	__asm__ __volatile__("yield" ::: "memory");
+}
+
+static __always_inline void cpu_relax(void)
+{
+	if (time_travel_mode == TT_MODE_INFCPU ||
+	    time_travel_mode == TT_MODE_EXTERNAL)
+		time_travel_ndelay(1);
+	else
+		native_pause();
+}
+
+#define task_pt_regs(t) (&(t)->thread.regs)
+
+#include <asm/processor-generic.h>
+
+#endif /* __UM_ARM_PROCESSOR_H */
diff --git a/arch/arm/um/asm/ptrace-abi.h b/arch/arm/um/asm/ptrace-abi.h
new file mode 100644
index 000000000..ec5070b17
--- /dev/null
+++ b/arch/arm/um/asm/ptrace-abi.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UM_ARM_PTRACE_ABI_H
+#define __UM_ARM_PTRACE_ABI_H
+
+/*
+ * Shadow of <asm/ptrace-abi.h> for ARCH=um SUBARCH=arm. x86 provides
+ * that name as a UAPI header carrying the PTRACE_* request numbers;
+ * arm has no file of that name, but the generic arch/um/kernel/ptrace.c
+ * includes it unconditionally, and two of the request numbers it
+ * dispatches on have no arm UAPI encoding at all:
+ *
+ *   PTRACE_SET_THREAD_AREA  arm has PTRACE_GET_THREAD_AREA (22) but no
+ *                           set half -- TLS is arch_set_tls(), and the
+ *                           port's ptrace_get/set_thread_area() return
+ *                           -ENOSYS for both. The value matches x86's.
+ *   PTRACE_SYSEMU[_SINGLESTEP]  arm has no seccomp-syscall-resume
+ *                           requests; the generic handler just answers
+ *                           them -EIO. The values match arm64's UAPI.
+ *
+ * PTRACE_PEEKUSR/POKEUSR come from <uapi/linux/ptrace.h> (via
+ * <linux/ptrace.h>), PTRACE_GETREGS/SETREGS/GET_THREAD_AREA from arm's
+ * own UAPI <uapi/asm/ptrace.h>, and the MAX_REG_OFFSET / getreg() /
+ * putreg() the GETREGS case needs are pulled in below.
+ */
+#include <sysdep/ptrace.h>
+
+#define PTRACE_SET_THREAD_AREA	26
+#define PTRACE_SYSEMU		31
+#define PTRACE_SYSEMU_SINGLESTEP 32
+
+extern unsigned long getreg(struct task_struct *child, int regno);
+extern int putreg(struct task_struct *child, int regno, unsigned long value);
+extern long subarch_ptrace(struct task_struct *child, long request,
+			   unsigned long addr, unsigned long data);
+
+#endif /* __UM_ARM_PTRACE_ABI_H */
diff --git a/arch/arm/um/asm/ptrace.h b/arch/arm/um/asm/ptrace.h
new file mode 100644
index 000000000..f48a43dc5 100644
--- /dev/null
+++ b/arch/arm/um/asm/ptrace.h
@@ -0,0 +1,123 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UM_ARM_PTRACE_H
+#define __UM_ARM_PTRACE_H
+
+/*
+ * Regsets the UML core dump / ptrace glue knows about. arm's real regset
+ * list is longer (VFP, IWMMXT, FPU, TLS...), but a UML guest has none of
+ * the optional ones: it is a userspace process whose FP state is whatever
+ * the host gave the stub. Only the core regset and, on hosts that have it,
+ * the VFP one are exposed.
+ */
+#ifndef __ASSEMBLER__
+enum {
+	REGSET_GENERAL,
+	REGSET_FP,
+};
+#endif /* __ASSEMBLER__ */
+
+#include <linux/compiler.h>
+#include <uapi/asm/ptrace.h>
+#include <asm/ptrace-generic.h>
+
+/*
+ * The 72-byte core-dump / user-area register block. arm32 has no host type
+ * of that name -- the kernel spells the PTRACE payload as a sigcontext, and
+ * the classic ptrace() regset as struct pt_regs -- so UGL carries a local
+ * mirror here: 18 words, r0-r10, fp, ip, sp, lr, pc, cpsr, orig_r0.
+ */
+#ifndef __ASSEMBLER__
+struct user_regs_struct {
+	unsigned int ureg[18];
+};
+#endif /* __ASSEMBLER__ */
+
+#define user_mode(r) UPT_IS_USER(&(r)->regs)
+
+#define PT_REGS_X(r, n)	UPT_X(&(r)->regs, n)
+#define PT_REGS_SP_REG(r) UPT_SP(&(r)->regs)
+
+#define PT_REGS_R0(r)	PT_REGS_X(r, HOST_R0)
+#define PT_REGS_R1(r)	PT_REGS_X(r, HOST_R1)
+#define PT_REGS_R2(r)	PT_REGS_X(r, HOST_R2)
+#define PT_REGS_R3(r)	PT_REGS_X(r, HOST_R3)
+#define PT_REGS_R4(r)	PT_REGS_X(r, HOST_R4)
+#define PT_REGS_R5(r)	PT_REGS_X(r, HOST_R5)
+#define PT_REGS_R6(r)	PT_REGS_X(r, HOST_R6)
+#define PT_REGS_R7(r)	PT_REGS_X(r, HOST_R7)
+#define PT_REGS_R8(r)	PT_REGS_X(r, HOST_R8)
+#define PT_REGS_R9(r)	PT_REGS_X(r, HOST_R9)
+#define PT_REGS_R10(r)	PT_REGS_X(r, HOST_R10)
+
+/* Frame pointer, for the generic KSTK_EBP/backtrace glue. */
+#define PT_REGS_BP(r)	PT_REGS_X(r, HOST_FP)
+#define PT_REGS_LR(r)	PT_REGS_X(r, HOST_LR)
+#define PT_REGS_CPSR(r)	PT_REGS_X(r, HOST_CPSR)
+
+/*
+ * The syscall return value is r0.
+ *
+ * PT_REGS_ORIG_SYSCALL is NOT r0. On x86 the two alias because EAX carries
+ * both the syscall number in and the result out, so arch/um/kernel/signal.c
+ * can write "PT_REGS_ORIG_SYSCALL(regs) = __NR_restart_syscall" and mean
+ * it. On arm the number went in r7 and the result comes out r0, so
+ * aliasing them would make that assignment clobber the return value instead
+ * of redirecting the syscall. It maps to the synthesised HOST_SYSCALL_NR
+ * slot, which is also what the ptrace and seccomp resume paths write back
+ * to the host.
+ */
+#define PT_REGS_SYSCALL_RET(r)	PT_REGS_X(r, HOST_R0)
+#define PT_REGS_ORIG_SYSCALL(r)	PT_REGS_X(r, HOST_SYSCALL_NR)
+
+#define PT_REGS_SET_SYSCALL_RETURN(r, res) (PT_REGS_X(r, HOST_R0) = (res))
+
+/*
+ * Bits of CPSR that a debugger (or a sigreturn frame) may set, mirroring
+ * the sanitisation in the parent arm kernel's valid_user_regs(): the flags,
+ * status and extension groups plus the T bit. Anything outside that either
+ * names a mode the guest cannot be in or masks interrupts it does not own,
+ * so the host would drop it on ptrace anyway; filtering here keeps the
+ * guest's own view consistent with what actually gets installed.
+ */
+#define UM_CPSR_WRITABLE						\
+	(PSR_f | PSR_s | PSR_x | PSR_T_BIT)
+
+#define PT_FIX_EXEC_STACK(sp) do ; while (0)
+
+#define profile_pc(regs) PT_REGS_IP(regs)
+
+#ifndef __ASSEMBLER__
+static inline long regs_return_value(struct pt_regs *regs)
+{
+	return PT_REGS_R0(regs);
+}
+#endif /* __ASSEMBLER__ */
+
+#define user_stack_pointer(regs) PT_REGS_SP(regs)
+
+/*
+ * arm has no LDT and no set_thread_area(2); TLS is R8, handled through
+ * arch_set_tls(). These exist only because arch/um/kernel/ptrace.c
+ * references them unconditionally.
+ */
+#ifndef __ASSEMBLER__
+struct user_desc;
+
+#include <asm/errno.h>
+
+static inline int ptrace_get_thread_area(struct task_struct *child, int idx,
+					 struct user_desc __user *user_desc)
+{
+	return -ENOSYS;
+}
+
+static inline int ptrace_set_thread_area(struct task_struct *child, int idx,
+					 struct user_desc __user *user_desc)
+{
+	return -ENOSYS;
+}
+
+extern void arch_switch_to(struct task_struct *to);
+#endif /* __ASSEMBLER__ */
+
+#endif /* __UM_ARM_PTRACE_H */
diff --git a/arch/arm/um/asm/segment.h b/arch/arm/um/asm/segment.h
new file mode 100644
index 000000000..08449df7c
--- /dev/null
+++ b/arch/arm/um/asm/segment.h
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UM_ARM_SEGMENT_H
+#define __UM_ARM_SEGMENT_H
+
+/*
+ * arm has no segment registers: <asm/segment.h> is an x86 thing. The
+ * generic UGL thread_info.h still includes it and the generic
+ * arch/um/kernel/asm-offsets.c still records GDT_ENTRY_TLS_ENTRIES, so
+ * the shadow exists. TLS on arm is a register (r8), not a descriptor
+ * table entry, so there is nothing to count.
+ */
+#define GDT_ENTRY_TLS_ENTRIES 0
+
+#endif /* __UM_ARM_SEGMENT_H */
diff --git a/arch/arm/um/asm/string.h b/arch/arm/um/asm/string.h
new file mode 100644
index 000000000..628e48718
--- /dev/null
+++ b/arch/arm/um/asm/string.h
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UM_ARM_STRING_H
+#define __UM_ARM_STRING_H
+
+/*
+ * arch/arm/include/asm/string.h declares the arch's own memcpy, memset,
+ * memmove, and the __-prefixed KASan instrumentation variants, all backed
+ * by arch/arm/lib, which is not built for ARCH=um. Declaring the
+ * __HAVE_ARCH_* macros here would suppress lib/string.c's generic
+ * implementations and leave the symbols undefined at link time; the
+ * KASan-underscore forms are plain name collisions with the glibc the UML
+ * binary links against.
+ *
+ * Declaring no __HAVE_ARCH_* at all lets lib/string.c supply everything.
+ * That also keeps UML's -Dstrrchr=kernel_strrchr renaming (see
+ * arch/um/Makefile) working, which is what stops the kernel's string
+ * functions from colliding with the libc that the UML binary is linked
+ * against.
+ */
+
+/*
+ * Against bionic, let libc supply these.
+ *
+ * The comment above explains why no __HAVE_ARCH_* is declared for a glibc
+ * build: arch/arm/lib is not compiled for ARCH=um, so claiming the arch
+ * has its own would leave the symbols undefined. Against bionic the
+ * situation is the opposite -- libc.a certainly has them, and its objects
+ * get pulled in regardless because bionic's libc is coarser-grained than
+ * glibc's, so the kernel's copies in lib/string.c collide with libc's at
+ * static link time.
+ *
+ * Declaring them here stops lib/string.c compiling its own, which removes
+ * the collision at the source rather than renaming one side of it.
+ * Renaming is the wrong tool for this family in particular:
+ * CONFIG_FORTIFY_SOURCE redefines these names as macros, so a
+ * -Dstrchr=kernel_strchr fights the fortify wrappers and produces "call to
+ * undeclared library function 'strchr'".
+ */
+#ifdef __ANDROID__
+#define __HAVE_ARCH_MEMCPY
+#define __HAVE_ARCH_MEMSET
+#define __HAVE_ARCH_MEMMOVE
+#define __HAVE_ARCH_MEMCMP
+#define __HAVE_ARCH_MEMCHR
+#define __HAVE_ARCH_STRCMP
+#define __HAVE_ARCH_STRCPY
+#define __HAVE_ARCH_STRCHR
+#define __HAVE_ARCH_STRCHRNUL
+#define __HAVE_ARCH_STRLEN
+#define __HAVE_ARCH_STRNCMP
+#define __HAVE_ARCH_STRNLEN
+
+/*
+ * __HAVE_ARCH_* tells <linux/string.h> that the architecture declares
+ * these, so it stops declaring them itself. Here "the architecture" is
+ * libc, so declare them with the signatures libc uses and let the link
+ * resolve them there.
+ */
+void *memcpy(void *, const void *, __kernel_size_t);
+void *memset(void *, int, __kernel_size_t);
+void *memmove(void *, const void *, __kernel_size_t);
+int memcmp(const void *, const void *, __kernel_size_t);
+void *memchr(const void *, int, __kernel_size_t);
+int strcmp(const char *, const char *);
+char *strcpy(char *, const char *);
+char *strchr(const char *, int);
+char *strchrnul(const char *, int);
+__kernel_size_t strlen(const char *);
+int strncmp(const char *, const char *, __kernel_size_t);
+__kernel_size_t strnlen(const char *, __kernel_size_t);
+#endif
+
+#endif /* __UM_ARM_STRING_H */
diff --git a/arch/arm/um/asm/syscall.h b/arch/arm/um/asm/syscall.h
new file mode 100644
index 000000000..9b2483f16
--- /dev/null
+++ b/arch/arm/um/asm/syscall.h
@@ -0,0 +1,37 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UM_ARM_SYSCALL_H
+#define __UM_ARM_SYSCALL_H
+
+/*
+ * The parent arch/arm/include/asm/syscall.h is the kernel's own: it tracks
+ * OABI versus EABI calls in the task's abi_syscall slot and masks numbers
+ * against __NR_SYSCALL_BASE -- machinery for a kernel running on arm
+ * hardware. None of it exists in UML, where there is a single EABI
+ * syscall table and the original first argument is an ordinary regset word.
+ */
+
+#include <asm/syscall-generic.h>
+#include <uapi/linux/audit.h>
+#include <asm/unistd.h>
+
+typedef asmlinkage long (*sys_call_ptr_t)(unsigned long, unsigned long,
+					  unsigned long, unsigned long,
+					  unsigned long, unsigned long);
+
+extern const sys_call_ptr_t sys_call_table[];
+
+/*
+ * The guest syscall table's entry count, the same definition as the
+ * parent arch/arm/include/asm/syscall.h: arch/arm/include/asm/seccomp.h
+ * uses it in SECCOMP_ARCH_NATIVE_NR. __NR_syscalls comes from
+ * <asm/unistd.h>, which in this build reaches the port's <asm/unistd-nr.h>
+ * shadow for the count.
+ */
+#define NR_syscalls (__NR_syscalls)
+
+static inline int syscall_get_arch(struct task_struct *task)
+{
+	return AUDIT_ARCH_ARM;
+}
+
+#endif /* __UM_ARM_SYSCALL_H */
