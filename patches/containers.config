# Kernel config fragment: enable container support (Docker/Podman/LXC) on UML.
#
# Applied via `scripts/kconfig/merge_config.sh` on top of the base defconfig.
# Favour cgroup v2 (unified hierarchy) — Docker >= 20.10 and Podman default to v2;
# the kernel exposes v2 by simply mounting `cgroup2` (no Kconfig switch needed,
# only the controllers below). cgroup v1 stays available as fallback.
#
# Runtime notes for UML specifically:
#   - VETH/BRIDGE/MACVLAN/IPVLAN work *inside* the guest for container traffic.
#     There is no host TAP bridge; egress to the host uses UML's own
#     vector/slirp transport (separate from the in-guest bridge).
#   - overlay2 is the storage driver to use (enabled here) on a raw ubd file.
#     /dev/loop* and device-mapper are available too — see patches/storage.config
#     — but overlay2 is still the right default for Docker/Podman on UML.
#

# === Namespaces (isolation primitives) ===
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_CGROUP_NS=y

# === Cgroup v2 controllers ===
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_RDMA=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_MISC=y
CONFIG_SOCK_CGROUP_DATA=y
CONFIG_MEMCG=y
# MEMCG_SWAP was folded into MEMCG on newer kernels; keep for older LTS.
CONFIG_MEMCG_SWAP=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CPUSETS=y
CONFIG_PROC_PID_CPUSET=y

# === Checkpoint / CRIU ===
CONFIG_CHECKPOINT_RESTORE=y

# === Seccomp — Docker/Podman hard-require this ===
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECCOMP_CACHE=y

# === Storage ===
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_FHANDLE=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FANOTIFY=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# === Networking: container bridge + NAT + iptables ===
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_TUN=y
CONFIG_TAP=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_DEFRAG_IPV4=y
CONFIG_NF_DEFRAG_IPV6=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_IPRANGE=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_IP_VS=y
CONFIG_IP_SET=y

# === Netfilter / nf_tables Backend ===
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_CT=y
CONFIG_NFT_CONNLIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_NAT=y
CONFIG_NFT_TUNNEL=y
CONFIG_NFT_OBJREF=y
CONFIG_NFT_QUEUE=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_HASH=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_OSF=y
CONFIG_NFT_TPROXY=y
CONFIG_NFT_SYNPROXY=y

# === WireGuard & Policy Routing (ip rule / fwmark) ===
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_WIREGUARD=y
CONFIG_CRYPTO_CURVE25519=y
CONFIG_CRYPTO_CHACHA20POLY1305=y

# === BPF / keys / security ===
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_KEYS=y
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_YAMA=y

# === Swap & zRAM Support ===
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZCOMP_LZ4=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y
# CONFIG_ZRAM_WRITEBACK is optional; enables backing store on disk
CONFIG_ZRAM_WRITEBACK=y

# === memdrop (uml-memdrop-on-free.patch) via PAGE_REPORTING ===
# Isolates free buddy pages then MADV_REMOVE host physmem backing.
CONFIG_PAGE_REPORTING=y
