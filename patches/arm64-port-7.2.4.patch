+                s.getOutputStream().write(0);
+                s.getOutputStream().flush();
+                s.close();
+                append("usb: descriptor sent to umusb\n");
+            } catch (Exception e) {
+                append("usb: handing over the descriptor failed: " + e + "\n");
+            }
+        }
+    }
+
+    private void usbRelease() {
