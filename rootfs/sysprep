#!/bin/sh
set -e

# Package-manager cleanup, whichever family this image is (Alpine's busybox
# truncate/find/dd cover everything else below).
echo "[*] Package manager cleanup"
if command -v apt-get >/dev/null 2>&1; then
	apt-get clean
	rm -rf /var/lib/apt/lists/*
	rm -rf /var/cache/apt/*
elif command -v apk >/dev/null 2>&1; then
	apk cache clean 2>/dev/null || rm -rf /var/cache/apk/*
elif command -v dnf >/dev/null 2>&1; then
	dnf clean all
fi

echo "[*] Remove SSH host keys"
rm -f /etc/ssh/ssh_host_*

echo "[*] Clear logs"
find /var/log -type f -exec truncate -s 0 {} \;

echo "[*] Remove machine-id"
rm -f /etc/machine-id
: > /etc/machine-id

echo "[*] Sync before zero-fill"
sync

echo "[*] Zero-fill free space"
dd if=/dev/zero of=/ZERO bs=1M || true
sync
rm -f /ZERO
sync

echo "[*] Sysprep complete"

