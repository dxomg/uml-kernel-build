#!/bin/sh
set -e
BASE="$(cd "$(dirname "$0")" && pwd)"
KERNEL="$BASE/linux"
ROOTFS="${UML_ROOTFS:-$BASE/base.img}"
CONFIG="$BASE/config.yaml"

yaml_val() {
    grep -E "^${1}:" "$CONFIG" 2>/dev/null | head -1 | sed 's/^[^:]*:[[:space:]]*//' | tr -d '"'
}

# --- network helper: the Go netstack engine. The C slirp helpers
# --- (legacy/ and vde_plug/) are built and run standalone when needed.
ENGINE_BIN="$BASE/vdeplug-netstack"
# The kernel's run_helper execs "vde_plug" by that exact name from PATH,
# so point the name at the engine binary.
ln -snf "$ENGINE_BIN" "$BASE/vde_plug"

# --- arguments: [memory] [ncpus]  (both optional, config.yaml overrides) ---
MEMORY="${1:-$(yaml_val memory)}"
MEMORY="${MEMORY:-2G}"
NCPUS="${2:-$(yaml_val ncpus)}"
NCPUS="${NCPUS:-1}"
# coerce to a positive integer (ignore garbage from config/argv)
case "$NCPUS" in
    ''|*[!0-9]*) NCPUS=1 ;;
esac
[ "$NCPUS" -lt 1 ] && NCPUS=1

for f in "$KERNEL" "$ROOTFS" "$ENGINE_BIN"; do
    if [ ! -f "$f" ]; then echo "[ERROR] Missing: $f"; exit 1; fi
done
if [ ! -x "$ENGINE_BIN" ]; then chmod +x "$ENGINE_BIN"; fi
if [ ! -x "$KERNEL" ]; then chmod +x "$KERNEL"; fi

# --- stable per-image guest MAC: generated once at first boot, kept
# --- forever, so DHCP leases and switch learning survive reboots ---
MACFILE="$ROOTFS.mac"
if [ ! -s "$MACFILE" ]; then
    printf '02:%02x:%02x:%02x:%02x:%02x\n' $(od -An -tu1 -N5 /dev/urandom) > "$MACFILE"
    chmod 600 "$MACFILE"
fi
GUEST_MAC=$(tr -cd '0-9a-f:' < "$MACFILE")

# --- detect whether the kernel was built with SMP ---
KERNEL_HAS_SMP=0
if command -v strings >/dev/null 2>&1 && strings "$KERNEL" 2>/dev/null | grep -q '^CONFIG_SMP=y'; then
    KERNEL_HAS_SMP=1
fi

# --- /dev/shm usable? (used to decide the skas0 PTRACE fallback) ---
SHM_TEST=$(mktemp /dev/shm/.uml_XXXXXX 2>/dev/null) || true
if [ -n "$SHM_TEST" ]; then
    printf '#!/bin/sh\nexit 0\n' > "$SHM_TEST"
    chmod +x "$SHM_TEST" 2>/dev/null
    if "$SHM_TEST" 2>/dev/null; then SHM_OK=1; else SHM_OK=0; fi
    rm -f "$SHM_TEST"
else
    SHM_OK=0
fi

# --- build the kernel cmdline ---
#
# Userspace-mode rules:
#   * seccomp=auto — use the SECCOMP userspace when the host kernel offers it
#                    (it is the faster mode), fall back to ptrace otherwise.
#                    An "on" here would mean *required*: on hosts whose kernel
#                    is too old for seccomp filters (old Android phones) the
#                    boot would die in the capability checks instead of
#                    degrading. The ptrace fallback on arm32 intercepts guest
#                    syscalls by cancelling them at a PTRACE_SYSCALL stop, so
#                    it works where PTRACE_SYSEMU is absent too.
#   * ncpus=N      — how many vCPUs to bring online (<= NR_CPUS, default 1).
#                    SMP is incompatible with the ptrace userspace; when
#                    seccomp is unavailable the kernel clamps the count to 1
#                    with a message rather than refusing to boot.
#   * mode=skas0   — forces PTRACE userspace on kernels where seccomp is the
#                    default (6.x series). Only used when ncpus==1 AND
#                    /dev/shm is slow.
SMP_ARGS=""
SKAS_MODE=""

if [ "$KERNEL_HAS_SMP" -eq 1 ] && [ "$NCPUS" -gt 1 ]; then
    SMP_ARGS="ncpus=$NCPUS seccomp=auto"
elif [ "$KERNEL_HAS_SMP" -eq 1 ]; then
    SMP_ARGS="ncpus=1 seccomp=auto"
else
    if [ "$SHM_OK" -eq 0 ]; then
        SKAS_MODE="mode=skas0"
    fi
fi

# --- the SKAS stub, when shipped as a file next to the kernel ---
#
# Android refuses to exec a binary from an anonymous memfd (not only inside
# an app sandbox), so the stub can never be exec'd there and the guest dies
# before it prints its version. The stub_exe=<path> boot argument points the
# kernel at a file copy instead; the kernel artifacts ship it as `stub_exe`.
# Passing it is harmless on hosts where the memfd works.
STUB_EXE_ARG=""
if [ -f "$BASE/stub_exe" ]; then
    STUB_EXE_ARG="stub_exe=$BASE/stub_exe"
fi

if [ "$SHM_OK" -eq 0 ]; then
    mkdir -p "$BASE/.uml_tmp"
    export TMP="$BASE/.uml_tmp" TMPDIR="$BASE/.uml_tmp" TEMP="$BASE/.uml_tmp"
fi

export PATH="$BASE:$PATH"

echo "========================================"
echo "  UML Virtual Machine"
echo "----------------------------------------"
if [ "$KERNEL_HAS_SMP" -eq 1 ] && [ "$NCPUS" -gt 1 ]; then
    echo "  CPUs     : $NCPUS (SMP, seccomp userspace)"
elif [ "$KERNEL_HAS_SMP" -eq 1 ]; then
    echo "  CPUs     : 1 (SMP kernel, 1 vCPU)"
else
    echo "  CPUs     : 1 (UP kernel)"
fi
echo "  Memory   : $MEMORY"
echo "  Network  : VDE VECTOR + netstack NAT"
if [ -n "$SKAS_MODE" ]; then echo "  Userspace: skas0 (slow /dev/shm fallback)"; fi
if [ -n "$STUB_EXE_ARG" ]; then echo "  Stub     : file (stub_exe=)"; fi
echo "  Config   : $CONFIG"
echo "----------------------------------------"
echo "  Login: root / root"
echo "========================================"
echo ""

cleanup() { if [ -n "$SKAS_MODE" ]; then rm -rf "$BASE/.uml_tmp" 2>/dev/null; fi; }
trap cleanup EXIT

exec "$KERNEL" \
    mem="$MEMORY" \
    $SKAS_MODE \
    $SMP_ARGS \
    $STUB_EXE_ARG \
    ubd0="$ROOTFS" \
    root=/dev/ubda rw \
    init=/lib/systemd/systemd \
    "vec0:transport=vde,vnl=slirp://,mac=$GUEST_MAC" \
    con0=fd:0,fd:1 \
    con=null
